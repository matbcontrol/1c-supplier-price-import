КонецПроцедуры

Процедура НайтиЕдиницыИзмерения(Позиции)

	Словарь = Неопределено;
	Для Каждого Позиция Из Позиции Цикл
		Если ПустаяСтрока(Позиция.Единица) Тогда
			Продолжить;
		КонецЕсли;
		Если Словарь = Неопределено Тогда
			Словарь = СловарьЕдиниц();
		КонецЕсли;
		Единица = Словарь[НормализоватьТекст(Позиция.Единица)];
		Если Единица <> Неопределено Тогда
			Позиция.ЕдиницаИзмерения = Единица;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Словарь «текст → единица классификатора»: краткое и полное наименование, наименование без скобок,
// международное сокращение, код ОКЕИ и привычные синонимы.
// Синонимы ссылаются на коды ОКЕИ: в классификаторе «л.» - это лист, а литр записан как «л (дм3)».
Функция СловарьЕдиниц()

	Словарь = Новый Соответствие;
	ПоКоду = Новый Соответствие;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Е.Ссылка КАК Ссылка,
	|	Е.Код КАК Код,
	|	Е.Наименование КАК Наименование,
	|	Е.НаименованиеПолное КАК НаименованиеПолное,
	|	Е.МеждународноеСокращение КАК МеждународноеСокращение
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК Е
	|ГДЕ
	|	НЕ Е.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоКоду.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
		Варианты = Новый Массив;
		Варианты.Добавить(Выборка.Наименование);
		Скобка = СтрНайти(Выборка.Наименование, "(");
		Если Скобка > 1 Тогда
			Варианты.Добавить(Лев(Выборка.Наименование, Скобка - 1));
		КонецЕсли;
		Варианты.Добавить(Выборка.НаименованиеПолное);
		Варианты.Добавить(Выборка.МеждународноеСокращение);
		Варианты.Добавить(Выборка.Код);
		Для Каждого Вариант Из Варианты Цикл
			Ключ = НормализоватьТекст(Вариант);
			Если Не ПустаяСтрока(Ключ) И Словарь[Ключ] = Неопределено Тогда
				Словарь.Вставить(Ключ, Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Синонимы = Новый Соответствие;
	Синонимы.Вставить("796", "шт|шт.|штук|штука|штуки|pcs|pc|ед|ед.");
	Синонимы.Вставить("112", "л|л.|литр|литров|liter|ltr");
	Синонимы.Вставить("166", "кг|кг.|килограмм|kg");
	Синонимы.Вставить("006", "м|м.|метр|метров|пог. м|пог.м|п.м");
	Синонимы.Вставить("778", "упак|упак.|уп|уп.|упаковка|упаковок|pack");
	Синонимы.Вставить("055", "м2|кв.м|кв. м|м.кв");
	Для Каждого КодИСинонимы Из Синонимы Цикл
		Единица = ПоКоду[КодИСинонимы.Ключ];
		Если Единица = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Синоним Из СтрРазделить(КодИСинонимы.Значение, "|", Ложь) Цикл
			Словарь.Вставить(НормализоватьТекст(Синоним), Единица);
		КонецЦикла;
	КонецЦикла;
	Возврат Словарь;

КонецФункции

Процедура ПрочитатьСвойстваТоваров(Позиции)

	Товары = ЗначенияКолонки(Позиции, "Номенклатура");
	Если Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Н.ПроверятьЗаполнениеХарактеристики КАК НужнаХарактеристика,
	|	Н.Родитель КАК Родитель
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	Н.Ссылка В (&Товары)";
	Запрос.УстановитьПараметр("Товары", Товары);
	Свойства = Запрос.Выполнить().Выгрузить();
	Свойства.Индексы.Добавить("Ссылка");

	Для Каждого Позиция Из Позиции Цикл
		Если Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Свойство = Свойства.Найти(Позиция.Номенклатура, "Ссылка");
		Позиция.ЕдиницаТовара = Свойство.ЕдиницаИзмерения;
		Позиция.НужнаХарактеристика = Свойство.НужнаХарактеристика;
		Позиция.ГруппаТовара = Свойство.Родитель;
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьТекущиеЦены(Позиции, Параметры)

	Товары = ЗначенияКолонки(Позиции, "Номенклатура");
	Если Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ВидЦенПоставщика = ?(ЗначениеЗаполнено(Параметры.ВидЦенПоставщика), Параметры.ВидЦенПоставщика, ВидЦенПоставщика(Параметры.Поставщик));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ц.Номенклатура КАК Номенклатура,
	|	Ц.Цена КАК Цена,
	|	Ц.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(
	|			,
	|			ВидЦенКонтрагента = &ВидЦенПоставщика
	|				И Номенклатура В (&Товары)
	|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Ц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ц.Номенклатура КАК Номенклатура,
	|	Ц.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦен = &ВидЦенРРЦ
	|				И Номенклатура В (&Товары)
	|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Ц";
	Запрос.УстановитьПараметр("ВидЦенПоставщика", ВидЦенПоставщика);
	Запрос.УстановитьПараметр("ВидЦенРРЦ", Параметры.ВидЦенРРЦ);
	Запрос.УстановитьПараметр("Товары", Товары);
	Пакет = Запрос.ВыполнитьПакет();
	ЦеныПоставщика = Пакет[0].Выгрузить();
	ЦеныПоставщика.Индексы.Добавить("Номенклатура");
	ЦеныРРЦ = Пакет[1].Выгрузить();
	ЦеныРРЦ.Индексы.Добавить("Номенклатура");

	Для Каждого Позиция Из Позиции Цикл
		Если Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Цена = ЦеныПоставщика.Найти(Позиция.Номенклатура, "Номенклатура");
		Если Цена <> Неопределено Тогда
			Позиция.ЦенаБыло = Цена.Цена;
			Позиция.ДатаЦеныБыло = Цена.Период;
		КонецЕсли;
		Цена = ЦеныРРЦ.Найти(Позиция.Номенклатура, "Номенклатура");
		Если Цена <> Неопределено Тогда
			Позиция.РРЦБыло = Цена.Цена;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Группа для нового товара: та, где лежит большинство уже известных товаров из той же категории прайса.
// Если по соседям не понять - группа с тем же названием, что категория, иначе группа для новых.
Процедура ОпределитьГруппыНовыхТоваров(Позиции, Параметры)

	Голоса = Новый Соответствие;
	Для Каждого Позиция Из Позиции Цикл
		Если Не ЗначениеЗаполнено(Позиция.Номенклатура) Или ПустаяСтрока(Позиция.Категория) Тогда
			Продолжить;
		КонецЕсли;
		ПоКатегории = Голоса[Позиция.Категория];
		Если ПоКатегории = Неопределено Тогда
			ПоКатегории = Новый Соответствие;
			Голоса.Вставить(Позиция.Категория, ПоКатегории);
		КонецЕсли;
		ПоКатегории.Вставить(Позиция.ГруппаТовара, ?(ПоКатегории[Позиция.ГруппаТовара] = Неопределено, 0, ПоКатегории[Позиция.ГруппаТовара]) + 1);
	КонецЦикла;

	Для Каждого Позиция Из Позиции Цикл
		Если ЗначениеЗаполнено(Позиция.Номенклатура) Или Позиция.ЕстьОшибка Тогда
			Продолжить;
		КонецЕсли;
		Группа = Справочники.Номенклатура.ПустаяСсылка();
		ПоКатегории = Голоса[Позиция.Категория];
		Если ПоКатегории <> Неопределено Тогда
			Максимум = 0;
			Для Каждого КлючИЗначение Из ПоКатегории Цикл
				Если КлючИЗначение.Значение > Максимум И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
					Максимум = КлючИЗначение.Значение;
					Группа = КлючИЗначение.Ключ;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Группа) И Не ПустаяСтрока(Позиция.Категория) Тогда
			Группа = Справочники.Номенклатура.НайтиПоНаименованию(Позиция.Категория, Истина);
			Если ЗначениеЗаполнено(Группа) И Не Группа.ЭтоГруппа Тогда
				Группа = Справочники.Номенклатура.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		Позиция.ГруппаТовара = ?(ЗначениеЗаполнено(Группа), Группа, Параметры.ГруппаДляНовых);
	КонецЦикла;

КонецПроцедуры

Процедура ОпределитьСтатус(Позиция, Параметры)

	Если Позиция.ЕстьОшибка Тогда
		Позиция.Статус = "Ошибка";
		Возврат;
	КонецЕсли;

	ЕстьЦена = Позиция.Цена > 0;
	Если Не ЕстьЦена И (Позиция.РРЦ = 0 Или ЭтоЦенаПоЗапросу(Позиция.ТекстЦены)) Тогда
		Позиция.Статус = "Нет цены";
		Позиция.Комментарий = ?(ПустаяСтрока(Позиция.ТекстЦены), НСтр("ru = 'цена в прайсе не указана'"),
			СтрШаблон(НСтр("ru = 'в прайсе: «%1»'"), Позиция.ТекстЦены));
		Возврат;
	КонецЕсли;

	// Новый товар.
	Если Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
		Если Не Параметры.СоздаватьНовыеТовары Тогда
			Позиция.Статус = "Пропущен";
			Позиция.Комментарий = НСтр("ru = 'товара нет в базе, создание новых выключено'");
		ИначеЕсли ПустаяСтрока(Позиция.Наименование) Тогда
			ОтметитьОшибку(Позиция, НСтр("ru = 'товара нет в базе, а наименования для нового нет'"));
			Позиция.Статус = "Ошибка";
		ИначеЕсли Не ЗначениеЗаполнено(Позиция.ЕдиницаИзмерения) И Не ПустаяСтрока(Позиция.Единица) Тогда
			ОтметитьОшибку(Позиция, СтрШаблон(НСтр("ru = 'единицы «%1» нет в классификаторе, добавьте её или исправьте прайс'"), Позиция.Единица));
			Позиция.Статус = "Ошибка";
		Иначе
			Позиция.Статус = "Новый";
			Позиция.Применить = Истина;
			Позиция.ИзменитсяЦена = ЕстьЦена;
			Позиция.ИзменитсяРРЦ = Позиция.РРЦ > 0;
			Позиция.Комментарий = СтрШаблон(НСтр("ru = 'будет создан в группе «%1»'"),
				?(ЗначениеЗаполнено(Позиция.ГруппаТовара), Строка(Позиция.ГруппаТовара), ГруппаДляНовыхПоУмолчанию(Параметры)));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Позиция.НужнаХарактеристика Тогда
		ОтметитьОшибку(Позиция, НСтр("ru = 'у товара в базе обязательна характеристика (размер, цвет), а в прайсе её нет; УНФ не примет цену без характеристики'"));
		Позиция.Статус = "Ошибка";
		Возврат;
	КонецЕсли;

	Замечания = Новый Массив;
	Проверить = Ложь;

	Если Параметры.ЗаписыватьЦеныПоставщика И ЕстьЦена И Позиция.Цена <> Позиция.ЦенаБыло Тогда
		Позиция.ИзменитсяЦена = Истина;
		Процент = ПроцентИзменения(Позиция.ЦенаБыло, Позиция.Цена);
		Позиция.ЦенаИзменение = ?(Процент = Неопределено, 0, Процент);
		Если Процент <> Неопределено И Макс(Процент, -Процент) > Параметры.ПорогИзменения Тогда
			Проверить = Истина;
			Замечания.Добавить(НСтр("ru = 'цена поставщика: '") + ОписаниеИзменения(Позиция.ЦенаБыло, Позиция.Цена));
		КонецЕсли;
		Если ЗначениеЗаполнено(Позиция.ДатаЦеныБыло) И Позиция.ДатаЦеныБыло > Параметры.ДатаПрайса Тогда
			Проверить = Истина;
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'в базе уже есть цена поставщика от %1, прайс старше'"), Формат(Позиция.ДатаЦеныБыло, "ДЛФ=D")));
		КонецЕсли;
	КонецЕсли;

	Если Параметры.ЗаписыватьРРЦ И Позиция.РРЦ > 0 И Позиция.РРЦ <> Позиция.РРЦБыло Тогда
		Позиция.ИзменитсяРРЦ = Истина;
		Процент = ПроцентИзменения(Позиция.РРЦБыло, Позиция.РРЦ);
		Позиция.РРЦИзменение = ?(Процент = Неопределено, 0, Процент);
		Если Процент <> Неопределено И Макс(Процент, -Процент) > Параметры.ПорогИзменения Тогда
			Проверить = Истина;
			Замечания.Добавить(НСтр("ru = 'РРЦ: '") + ОписаниеИзменения(Позиция.РРЦБыло, Позиция.РРЦ));
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Позиция.ЕдиницаИзмерения) И ЗначениеЗаполнено(Позиция.ЕдиницаТовара)
		И Позиция.ЕдиницаИзмерения <> Позиция.ЕдиницаТовара И (Позиция.ИзменитсяЦена Или Позиция.ИзменитсяРРЦ) Тогда
		Проверить = Истина;
		Замечания.Добавить(СтрШаблон(НСтр("ru = 'в прайсе цена за «%1», а товар в базе учитывается в «%2»'"),
			Позиция.ЕдиницаИзмерения, Позиция.ЕдиницаТовара));
	КонецЕсли;

	Если Проверить Тогда
		Позиция.Статус = "Проверить";
		Позиция.Применить = Ложь;
		Позиция.Комментарий = СтрСоединить(Замечания, "; ");
	ИначеЕсли Позиция.ИзменитсяЦена Или Позиция.ИзменитсяРРЦ Тогда
		Позиция.Статус = "Изменение цены";
		Позиция.Применить = Истина;
	Иначе
		Позиция.Статус = "Без изменений";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Запись

// Создаёт объекты новых товаров и проверяет заполнение. Записываются они позже, в транзакции загрузки.
//
// Возвращаемое значение:
//  Соответствие - ключ: строка таблицы позиций, значение: СправочникОбъект.Номенклатура.
//
Функция ПодготовитьНовыеТовары(Позиции, Параметры)

	Результат = Новый Соответствие;
	Образцы = ОбразцыГрупп(Позиции);
	ГруппаПоУмолчанию = Неопределено;

	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.Статус <> "Новый" Или Не Позиция.Применить Тогда
			Продолжить;
		КонецЕсли;

		Группа = Позиция.ГруппаТовара;
		Если Не ЗначениеЗаполнено(Группа) Тогда
			Если ГруппаПоУмолчанию = Неопределено Тогда
				ГруппаПоУмолчанию = ГруппаДляНовых(Параметры);
			КонецЕсли;
			Группа = ГруппаПоУмолчанию;
		КонецЕсли;
		Образец = Образцы[Группа];

		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Запас);
		ДанныеЗаполнения.Вставить("ЕдиницаИзмерения", ?(ЗначениеЗаполнено(Позиция.ЕдиницаИзмерения), Позиция.ЕдиницаИзмерения,
			Справочники.КлассификаторЕдиницИзмерения.шт));
		Если Образец <> Неопределено Тогда
			// Категорию и ставку НДС новый товар берёт у соседа по группе, а не значение по умолчанию.
			ДанныеЗаполнения.Вставить("КатегорияНоменклатуры", Образец.КатегорияНоменклатуры);
		КонецЕсли;

		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.Заполнить(ДанныеЗаполнения);
		Объект.Наименование = Лев(Позиция.Наименование, 100);
		Объект.НаименованиеПолное = Позиция.Наименование;
		Объект.Артикул = Позиция.Артикул;
		Объект.Родитель = Группа;
		Объект.Поставщик = Параметры.Поставщик;
		Если Образец <> Неопределено И ЗначениеЗаполнено(Образец.ВидСтавкиНДС) Тогда
			Объект.ВидСтавкиНДС = Образец.ВидСтавкиНДС;
		КонецЕсли;

		ПолучитьСообщенияПользователю(Истина);
		Если Объект.ПроверитьЗаполнение() Тогда
			Результат.Вставить(Позиция, Объект);
		Иначе
			Позиция.Применить = Ложь;
			Позиция.Статус = "Ошибка";
			ОтметитьОшибку(Позиция, ТекстСообщений(НСтр("ru = 'новый товар не прошёл проверку заполнения'")));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Образцы для новых товаров: первый товар каждой группы, в которую что-то будет создано.
Функция ОбразцыГрупп(Позиции)

	Группы = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.Статус = "Новый" И ЗначениеЗаполнено(Позиция.ГруппаТовара) И Группы.Найти(Позиция.ГруппаТовара) = Неопределено Тогда
			Группы.Добавить(Позиция.ГруппаТовара);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Соответствие;
	Если Группы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Родитель КАК Группа,
	|	Н.КатегорияНоменклатуры КАК КатегорияНоменклатуры,
	|	Н.ВидСтавкиНДС КАК ВидСтавкиНДС
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	Н.Родитель В (&Группы)
	|	И НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Н.Код";
	Запрос.УстановитьПараметр("Группы", Группы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат[Выборка.Группа] = Неопределено Тогда
			Результат.Вставить(Выборка.Группа, Новый Структура("КатегорияНоменклатуры, ВидСтавкиНДС", Выборка.КатегорияНоменклатуры, Выборка.ВидСтавкиНДС));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗаписатьШтрихкод(Позиция)

	Если ПустаяСтрока(Позиция.Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Ш ГДЕ Ш.Штрихкод = &Штрихкод");
	Запрос.УстановитьПараметр("Штрихкод", Позиция.Штрихкод);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Позиция.Комментарий = Позиция.Комментарий + "; " + НСтр("ru = 'штрихкод уже занят другим товаром, не записан'");
		Возврат Ложь;
	КонецЕсли;
	Запись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Штрихкод = Позиция.Штрихкод;
	Запись.Номенклатура = Позиция.Номенклатура;
	Запись.Записать();
	Возврат Истина;

КонецФункции

// Запоминает «код поставщика → наш товар», чтобы в следующий раз найти товар сразу.
Функция ЗаписатьСоответствия(Позиции, Поставщик)

	Создано = 0;
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.ЕстьОшибка Или Позиция.ЕстьСоответствие Или Не ЗначениеЗаполнено(Позиция.Номенклатура)
			Или ПустаяСтрока(Позиция.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если Позиция.Статус = "Проверить" И Не Позиция.Применить Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		Элемент.Владелец = Поставщик;
		Элемент.Наименование = Лев(?(ПустаяСтрока(Позиция.Наименование), Строка(Позиция.Номенклатура), Позиция.Наименование), 100);
		Элемент.Идентификатор = Позиция.Ключ;
		Элемент.Артикул = Позиция.Артикул;
		Элемент.Номенклатура = Позиция.Номенклатура;
		Элемент.Записать();
		Позиция.ЕстьСоответствие = Истина;
		Создано = Создано + 1;
	КонецЦикла;
	Возврат Создано;

КонецФункции

// Цены поставщика пишутся одним набором записей на дату прайса: внутри большой транзакции
// запись по одной строке на товар растёт по времени быстрее, чем число строк.
// Набор читается целиком, чтобы не стереть цены этого поставщика на ту же дату по товарам не из прайса.
Функция ЗаписатьЦеныПоставщика(Позиции, ВидЦенПоставщика, Параметры)
	
	Период = НачалоДня(Параметры.ДатаПрайса);
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЦеныНоменклатурыКонтрагентов");
	ЭлементБлокировки.УстановитьЗначение("ВидЦенКонтрагента", ВидЦенПоставщика);
	ЭлементБлокировки.УстановитьЗначение("Период", Период);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	Набор = РегистрыСведений.ЦеныНоменклатурыКонтрагентов.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Период);
	Набор.Отбор.ВидЦенКонтрагента.Установить(ВидЦенПоставщика);
	Набор.Прочитать();
	Записи = Набор.Выгрузить();
	Записи.Индексы.Добавить("Номенклатура, Характеристика");
	
	Автор = Пользователи.ТекущийПользователь();
	ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Записано = 0;
	Для Каждого Позиция Из Позиции Цикл
		Если Не Позиция.Применить Или Не Позиция.ИзменитсяЦена Или Позиция.Цена <= 0 Или Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Найденные = Записи.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Позиция.Номенклатура, ПустаяХарактеристика));
		Запись = ?(Найденные.Количество() > 0, Найденные[0], Записи.Добавить());
		Запись.Период = Период;
		Запись.ВидЦенКонтрагента = ВидЦенПоставщика;
		Запись.Номенклатура = Позиция.Номенклатура;
		Запись.Характеристика = ПустаяХарактеристика;
		Запись.Цена = Позиция.Цена;
		Запись.Актуальность = Истина;
		Запись.ЕдиницаИзмерения = ЕдиницаПозиции(Позиция);
		Запись.Автор = Автор;
		Записано = Записано + 1;
		ДобавитьРезультат(Позиция, СтрШаблон(НСтр("ru = 'цена поставщика %1'"), Формат(Позиция.Цена, "ЧДЦ=2; ЧГ=")));
	КонецЦикла;
	
	Если Записано > 0 Тогда
		Набор.Загрузить(Записи);
		Набор.Записать(Истина);
	КонецЕсли;
	Возврат Записано;
	
КонецФункции

// РРЦ записываются типовым документом «Установка цен номенклатуры»: в нём видны старые и новые цены,
// загрузку можно отменить, распровев документ. Проведение документа УНФ замедляется быстрее, чем растёт
// число строк (100 строк - секунды, 200 - минуты), поэтому большие прайсы делятся на документы по 100 строк.
Функция ЗаписатьРРЦ(Позиции, Параметры, Документы)

	Записано = 0;
	Документ = Неопределено;
	ВидЦен = Параметры.ВидЦенРРЦ;
	Валюта = ВидЦен.ВалютаЦены;
	Для Каждого Позиция Из Позиции Цикл
		Если Не Позиция.Применить Или Не Позиция.ИзменитсяРРЦ Или Позиция.РРЦ <= 0 Или Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если Документ = Неопределено Тогда
			Документ = НовыйДокументЦен(Параметры);
		КонецЕсли;
		СтрокаДокумента = Документ.Запасы.Добавить();
		СтрокаДокумента.Номенклатура = Позиция.Номенклатура;
		СтрокаДокумента.ЕдиницаИзмерения = ЕдиницаПозиции(Позиция);
		СтрокаДокумента.ВидЦены = ВидЦен;
		СтрокаДокумента.Цена = Позиция.РРЦ;
		СтрокаДокумента.Валюта = Валюта;
		СтрокаДокумента.ЦенаСтарая = Позиция.РРЦБыло;
		СтрокаДокумента.ВалютаСтарая = Валюта;
		Записано = Записано + 1;
		ДобавитьРезультат(Позиция, СтрШаблон(НСтр("ru = 'РРЦ %1'"), Формат(Позиция.РРЦ, "ЧДЦ=2; ЧГ=")));
		Если Документ.Запасы.Количество() = СтрокВДокументеЦен() Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			Документы.Добавить(Документ.Ссылка);
			Документ = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Документ <> Неопределено Тогда
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Документы.Добавить(Документ.Ссылка);
	КонецЕсли;
	Возврат Записано;

КонецФункции

// Единица, в которой учитывается товар. Без обращения к реквизиту через точку (см. Загрузить).
