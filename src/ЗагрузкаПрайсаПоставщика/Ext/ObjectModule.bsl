#Область Разбор

Функция ПрочитатьCSV(ПутьКФайлу)

	// Сначала UTF-8; если в тексте появились символы замены, файл в Windows-1251 (так сохраняют Excel и старые выгрузки 1С).
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПутьКФайлу, КодировкаТекста.UTF8);
	Если СтрНайти(Текст.ПолучитьТекст(), Символ(65533)) > 0 Тогда
		Текст.Прочитать(ПутьКФайлу, "windows-1251");
	КонецЕсли;

	Результат = Новый Массив;
	Разделитель = Неопределено;
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл
		СтрокаТекста = Текст.ПолучитьСтроку(НомерСтроки);
		Если Разделитель = Неопределено И Не ПустаяСтрока(СтрокаТекста) Тогда
			Разделитель = РазделительCSV(СтрокаТекста);
		КонецЕсли;
		Ячейки = ?(ПустаяСтрока(СтрокаТекста), Новый Массив, РазобратьСтрокуCSV(СтрокаТекста, ?(Разделитель = Неопределено, ";", Разделитель)));
		Результат.Добавить(Новый Структура("НомерСтроки, Ячейки", НомерСтроки, Ячейки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазделительCSV(СтрокаТекста)

	Лучший = ";";
	Максимум = 0;
	Для Каждого Вариант Из СтрРазделить(";|" + Символы.Таб + "|,", "|") Цикл
		Количество = СтрЧислоВхождений(СтрокаТекста, Вариант);
		Если Количество > Максимум Тогда
			Максимум = Количество;
			Лучший = Вариант;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучший;

КонецФункции

// Excel показывает 199,99 как «200», если у ячейки формат без копеек, а штрихкод-число как «4,60703E+12».
// Поэтому для чисел берём настоящее значение ячейки, а не то, что видно на экране.
Функция ТекстЯчейки(Область)
	
	Если Область.СодержитЗначение И ТипЗнч(Область.Значение) = Тип("Число") Тогда
		Возврат Формат(Область.Значение, "ЧРД=,; ЧГ=0; ЧН=0");
	КонецЕсли;
	Возврат СокрЛП(Область.Текст);
	
КонецФункции

// Объединённая ячейка (заголовок раздела на всю ширину) читается в каждую колонку строки.
// Если все заполненные ячейки строки одинаковые, оставляем текст только в первой.
Процедура УбратьПовторОбъединеннойЯчейки(Ячейки)
	
	Первое = Неопределено;
	Заполнено = 0;
	Для Каждого Значение Из Ячейки Цикл
		Если ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Заполнено = Заполнено + 1;
		Если Первое = Неопределено Тогда
			Первое = Значение;
		ИначеЕсли Значение <> Первое Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Если Заполнено < 2 Тогда
		Возврат;
	КонецЕсли;
	Найден = Ложь;
	Для Индекс = 0 По Ячейки.ВГраница() Цикл
		Если Найден Тогда
			Ячейки[Индекс] = "";
		ИначеЕсли Не ПустаяСтрока(Ячейки[Индекс]) Тогда
			Найден = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Ключ позиции для соответствия поставщика: код поставщика, иначе артикул.
Функция КлючПозиции(Позиция)

	Возврат ?(ПустаяСтрока(Позиция.КодПоставщика), Позиция.Артикул, Позиция.КодПоставщика);

