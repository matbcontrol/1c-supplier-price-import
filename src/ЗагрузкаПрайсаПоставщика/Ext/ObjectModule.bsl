КонецПроцедуры

Процедура ПроверитьОбязательныеДанные(Позиции)

	Для Каждого Позиция Из Позиции Цикл
		Если ПустаяСтрока(Позиция.Ключ) И ПустаяСтрока(Позиция.Наименование) Тогда
			ОтметитьОшибку(Позиция, НСтр("ru = 'нет ни кода, ни артикула, ни наименования'"));
		ИначеЕсли Не ПустаяСтрока(Позиция.ТекстЦены) И ЧислоИзСтроки(Позиция.ТекстЦены) = Неопределено
			И Не ЭтоЦенаПоЗапросу(Позиция.ТекстЦены) Тогда
			ОтметитьОшибку(Позиция, СтрШаблон(НСтр("ru = 'цена «%1» не похожа на число'"), Позиция.ТекстЦены));
		ИначеЕсли Позиция.Цена < 0 Или Позиция.РРЦ < 0 Тогда
			ОтметитьОшибку(Позиция, НСтр("ru = 'отрицательная цена'"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПовторыВФайле(Позиции)

	Первые = Новый Соответствие;
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.ЕстьОшибка Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НормализоватьТекст(?(ПустаяСтрока(Позиция.Ключ), Позиция.Наименование, Позиция.Ключ));
		Первая = Первые[Ключ];
		Если Первая = Неопределено Тогда
			Первые.Вставить(Ключ, Позиция.НомерСтрокиФайла);
		Иначе
			ОтметитьОшибку(Позиция, СтрШаблон(НСтр("ru = 'повтор позиции из строки %1 прайса'"), Формат(Первая, "ЧГ=")));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура НайтиПоСоответствиюПоставщика(Позиции, Поставщик)

	Ключи = ЗначенияКолонки(Позиции, "Ключ");
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НП.Идентификатор КАК Ключ,
	|	НП.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК НП
	|ГДЕ
	|	НП.Владелец = &Поставщик
	|	И НЕ НП.ПометкаУдаления
	|	И НЕ НП.ЭтоГруппа
	|	И НП.Идентификатор В (&Ключи)
	|	И НЕ НП.Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Найденные = СоответствиеПоКлючу(Запрос.Выполнить().Выгрузить(), "Ключ");

	Для Каждого Позиция Из Позиции Цикл
		Товары = Найденные[НормализоватьТекст(Позиция.Ключ)];
		Если Позиция.ЕстьОшибка Или Товары = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Позиция.ЕстьСоответствие = Истина;
		УстановитьНайденное(Позиция, Товары, "соответствие");
	КонецЦикла;

КонецПроцедуры

Процедура НайтиПоШтрихкоду(Позиции)

	Штрихкоды = ЗначенияКолонки(Позиции, "Штрихкод", Истина);
	Если Штрихкоды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ш.Штрихкод КАК Ключ,
	|	Ш.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
	|ГДЕ
	|	Ш.Штрихкод В (&Штрихкоды)
	|	И НЕ Ш.Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Штрихкоды", Штрихкоды);
	Найденные = СоответствиеПоКлючу(Запрос.Выполнить().Выгрузить(), "Ключ");

	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.ЕстьОшибка Или ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Товары = Найденные[НормализоватьТекст(Позиция.Штрихкод)];
		Если Товары <> Неопределено Тогда
			УстановитьНайденное(Позиция, Товары, "штрихкод");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура НайтиПоАртикулу(Позиции)

	Артикулы = ЗначенияКолонки(Позиции, "Артикул", Истина);
	Если Артикулы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Артикул КАК Ключ,
	|	Н.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
