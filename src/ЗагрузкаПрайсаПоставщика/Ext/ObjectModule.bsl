	Для Каждого КлючИЗначение Из Колонки Цикл
		Части.Добавить(КлючИЗначение.Ключ + "=" + ?(КлючИЗначение.Значение = 0, "нет", Формат(КлючИЗначение.Значение, "ЧГ=")));
