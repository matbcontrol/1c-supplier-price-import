#Область РазборТекста

// Строка заголовков: среди первых 30 строк та, где узнаётся больше всего колонок (не меньше двух).
//
// Возвращаемое значение:
//  Число, Неопределено - индекс в массиве СтрокиФайла.
//
Функция НайтиСтрокуЗаголовка(СтрокиФайла) Экспорт

	ЛучшийИндекс = Неопределено;
	ЛучшийСчет = 1;
	Для Индекс = 0 По Мин(29, СтрокиФайла.ВГраница()) Цикл
		Колонки = ОпределитьКолонки(СтрокиФайла[Индекс].Ячейки);
		Счет = 0;
		Для Каждого КлючИЗначение Из Колонки Цикл
			Счет = Счет + ?(КлючИЗначение.Значение > 0, 1, 0);
		КонецЦикла;
		Если Счет > ЛучшийСчет Тогда
			ЛучшийСчет = Счет;
			ЛучшийИндекс = Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат ЛучшийИндекс;

КонецФункции

// Находит колонки по текстам заголовков. Каждая колонка достаётся одному полю.
// Порядок правил важен: «Штрихкод» раньше «Кода», «РРЦ» и «Цена розничная» раньше «Цены»,
// «Группа товаров» раньше «Товара».
//
// Параметры:
//  Заголовки - Массив из Строка
//
// Возвращаемое значение:
//  см. НовыеКолонки.
//
Функция ОпределитьКолонки(Заголовки) Экспорт

	Правила = Новый Массив;
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "Штрихкод", "штрихкод|штрих-код|штрих код|ean|barcode", ""));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "Артикул", "артикул|арт.|sku|vendor code", ""));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "КодПоставщика", "код поставщика|код товара", "код|id"));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "РРЦ", "ррц|розн|рекоменд|мрц", ""));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "Цена", "цена|опт|price|стоимость|закуп", ""));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "Единица", "единиц|ед.изм|ед. изм|unit", "ед"));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "Категория", "группа|категория|раздел|category|group", ""));
	Правила.Добавить(Новый Структура("Поле, Слова, Начало", "Наименование", "наименование|название|товар|номенклатура|name|product", ""));

	Колонки = НовыеКолонки();
	Занятые = Новый Соответствие;
	Для Каждого Правило Из Правила Цикл
		Слова = СтрРазделить(Правило.Слова, "|", Ложь);
		Начала = СтрРазделить(Правило.Начало, "|", Ложь);
		Для Индекс = 0 По Заголовки.ВГраница() Цикл
			Если Занятые[Индекс] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Заголовок = НормализоватьТекст(Заголовки[Индекс]);
			Если ПустаяСтрока(Заголовок) Или СтрДлина(Заголовок) > 40 Тогда
				Продолжить;
			КонецЕсли;
			Если СодержитОдноИз(Заголовок, Слова) Или НачинаетсяСоСлова(Заголовок, Начала) Тогда
				Колонки[Правило.Поле] = Индекс + 1;
				Занятые.Вставить(Индекс, Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Колонки;

КонецФункции

// Вид строки таблицы прайса: «Позиция», «Категория» (заголовок раздела), «Пустая» или «Служебная» (примечания).
Функция ВидСтроки(Ячейки, Колонки) Экспорт

	Заполнено = 0;
	Для Каждого Значение Из Ячейки Цикл
		Заполнено = Заполнено + ?(ПустаяСтрока(Значение), 0, 1);
	КонецЦикла;
	Если Заполнено = 0 Тогда
		Возврат "Пустая";
	КонецЕсли;

	ЕстьКлюч = Не ПустаяСтрока(Ячейка(Ячейки, Колонки.КодПоставщика))
		Или Не ПустаяСтрока(Ячейка(Ячейки, Колонки.Артикул))
		Или Не ПустаяСтрока(Ячейка(Ячейки, Колонки.Штрихкод));
	ЕстьЦена = Не ПустаяСтрока(Ячейка(Ячейки, Колонки.Цена)) Или Не ПустаяСтрока(Ячейка(Ячейки, Колонки.РРЦ));
	ЕстьНаименование = Не ПустаяСтрока(Ячейка(Ячейки, Колонки.Наименование));

	Если ЕстьКлюч Или (ЕстьНаименование И (ЕстьЦена Или Заполнено > 1)) Тогда
		Возврат "Позиция";
	КонецЕсли;

	// Заголовок раздела: одна короткая надпись без точки в конце (часто объединённая ячейка в первой колонке).
	Текст = ПервоеЗначение(Ячейки);
	Если Заполнено = 1 И СтрДлина(Текст) <= 60 И Не СтрЗаканчиваетсяНа(Текст, ".") Тогда
		Возврат "Категория";
	КонецЕсли;
	Возврат "Служебная";

КонецФункции

// «1 234,50», «650.5», «1,234.50», «890 ₽», «1 150 руб.» → число; не число → Неопределено.
Функция ЧислоИзСтроки(Знач Текст) Экспорт

	Текст = НРег(СокрЛП(Текст));
	Для Каждого Лишнее Из СтрРазделить("руб.|руб|р.|₽|rub|$|€| |" + Символы.НПП + "|" + Символы.Таб, "|", Ложь) Цикл
		Текст = СтрЗаменить(Текст, Лишнее, "");
	КонецЦикла;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Если есть и точка, и запятая, десятичный разделитель - тот, что правее; второй - разделитель тысяч.
	ПозицияТочки = СтрНайти(Текст, ".", НаправлениеПоиска.СКонца);
	ПозицияЗапятой = СтрНайти(Текст, ",", НаправлениеПоиска.СКонца);
	Если ПозицияТочки > 0 И ПозицияЗапятой > 0 Тогда
		Если ПозицияЗапятой > ПозицияТочки Тогда
			Текст = СтрЗаменить(Текст, ".", "");
		Иначе
			Текст = СтрЗаменить(Текст, ",", "");
		КонецЕсли;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, ",", ".");

	Точек = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "." Тогда
			Точек = Точек + 1;
		ИначеЕсли СтрНайти("0123456789", Символ) = 0 И Не (Символ = "-" И Позиция = 1) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Точек > 1 Или Текст = "-" Или Текст = "." Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Текст);

КонецФункции

// Первая дата вида ДД.ММ.ГГГГ или ДД.ММ.ГГ в тексте; пустая дата, если нет.
Функция ДатаИзТекста(Текст) Экспорт

	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Если ЭтоЦифра(Сред(Текст, Позиция, 1)) И (Позиция = 1 Или Не ЭтоЦифра(Сред(Текст, Позиция - 1, 1))) Тогда
			Части = Новый Массив;
			Текущая = "";
			Конец = Позиция;
			Пока Конец <= Длина Цикл
				Символ = Сред(Текст, Конец, 1);
				Если ЭтоЦифра(Символ) Тогда
					Текущая = Текущая + Символ;
				ИначеЕсли Символ = "." И Части.Количество() < 2 И Не ПустаяСтрока(Текущая) Тогда
					Части.Добавить(Текущая);
					Текущая = "";
				Иначе
					Прервать;
				КонецЕсли;
				Конец = Конец + 1;
			КонецЦикла;
			Части.Добавить(Текущая);
			Если Части.Количество() = 3 И СтрДлина(Части[0]) <= 2 И СтрДлина(Части[1]) <= 2
				И (СтрДлина(Части[2]) = 4 Или СтрДлина(Части[2]) = 2) Тогда
				День = Число(Части[0]);
				Месяц = Число(Части[1]);
				Год = Число(Части[2]) + ?(СтрДлина(Части[2]) = 2, 2000, 0);
				Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 И Год >= 2000 И Год <= 2100 Тогда
					Попытка
						Возврат Дата(Год, Месяц, День);
					Исключение
						// 31.02 и подобное - не дата, ищем дальше.
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			Позиция = Конец;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат '00010101';

КонецФункции

// Поддерживает кавычки: "Молоко ""Домик"", 1 л";89,90
// Кавычка открывает поле в кавычках, только если стоит в его начале. В CSV, собранных не Excel,
// часто встречается Мешки "Концепция быта";99 без обрамления: такие кавычки - часть названия.
Функция РазобратьСтрокуCSV(СтрокаТекста, Разделитель) Экспорт

	Ячейки = Новый Массив;
	Текущая = "";
	ВКавычках = Ложь;
	БылиКавычки = Ложь;
	Позиция = 1;
	Длина = СтрДлина(СтрокаТекста);
	Пока Позиция <= Длина Цикл
		Символ = Сред(СтрокаТекста, Позиция, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(СтрокаТекста, Позиция + 1, 1) = """" Тогда
					Текущая = Текущая + """";
					Позиция = Позиция + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Текущая = Текущая + Символ;
			КонецЕсли;
		ИначеЕсли Символ = """" И ПустаяСтрока(Текущая) И Не БылиКавычки Тогда
			ВКавычках = Истина;
			БылиКавычки = Истина;
			Текущая = "";
		ИначеЕсли Символ = Разделитель Тогда
			Ячейки.Добавить(СокрЛП(Текущая));
			Текущая = "";
			БылиКавычки = Ложь;
		Иначе
			Текущая = Текущая + Символ;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Ячейки.Добавить(СокрЛП(Текущая));
	Возврат Ячейки;

КонецФункции

// Нижний регистр, «ё» → «е», без кавычек любого вида, одиночные пробелы, без пробела перед запятой
// и без точки в конце: «Корзина «ВЕЛЕТТА» , 21 см» и «корзина "велетта", 21 см» совпадают.
Функция НормализоватьТекст(Знач Текст) Экспорт

	Текст = НРег(СокрЛП(Текст));
	Текст = СтрЗаменить(Текст, "ё", "е");
	Для Каждого Кавычка Из СтрРазделить("""|«|»|„|“|”", "|") Цикл
		Текст = СтрЗаменить(Текст, Кавычка, "");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Текст = СокрЛП(СтрЗаменить(Текст, " ,", ","));
	Если СтрЗаканчиваетсяНа(Текст, ".") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Изменение цены в процентах; Неопределено, если старой цены нет.
Функция ПроцентИзменения(Было, Стало) Экспорт

	Если Было = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Окр((Стало - Было) / Было * 100, 1);

КонецФункции

// Текст о подозрительном изменении: «рост в 10,0 раза», «+65,0 %», «−45,0 %».
Функция ОписаниеИзменения(Было, Стало) Экспорт

	Если Было > 0 И Стало / Было >= 3 Тогда
		Возврат СтрШаблон(НСтр("ru = 'рост в %1 раза (%2 → %3), похоже на ошибку в прайсе'"), Формат(Стало / Было, "ЧДЦ=1"),
			Формат(Было, "ЧДЦ=2; ЧГ="), Формат(Стало, "ЧДЦ=2; ЧГ="));
	КонецЕсли;
	Процент = ПроцентИзменения(Было, Стало);
	Возврат СтрШаблон(НСтр("ru = '%1%2 %% (%3 → %4)'"), ?(Процент > 0, "+", ""), Формат(Процент, "ЧДЦ=1; ЧН=0"),
		Формат(Было, "ЧДЦ=2; ЧГ="), Формат(Стало, "ЧДЦ=2; ЧГ="));

КонецФункции

