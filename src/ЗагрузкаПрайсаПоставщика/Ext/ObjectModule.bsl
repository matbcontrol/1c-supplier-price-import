// Загрузка прайс-листа поставщика в 1С:Управление нашей фирмой 3.0.
//
// Сценарий: поставщик присылает прайс в Excel или CSV в своём формате. Обработка
//  1) находит в файле строку заголовков, колонки и дату прайса, пропускает шапку, категории и примечания;
//  2) сопоставляет позиции с номенклатурой: по сохранённому соответствию поставщика, штрихкоду, артикулу, наименованию;
//  3) показывает, что изменится: было → стало, процент изменения; подозрительные изменения не применяет без подтверждения;
//  4) одной транзакцией создаёт новые товары, запоминает соответствия, пишет цены поставщика
//     и, если нужно, розничные цены (РРЦ) типовым документом «Установка цен номенклатуры»;
//  5) записывает итог в журнал регистрации.
//
// Пакетный режим (для регламентного запуска): см. ПакетнаяЗагрузка().

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Регистрация в справочнике «Дополнительные отчеты и обработки».
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "2.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация = НСтр("ru = 'Загрузка прайс-листа поставщика: цены поставщика, РРЦ, новые товары.'");

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Загрузка прайса поставщика'");
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Параметры загрузки по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Поставщик - СправочникСсылка.Контрагенты
//   * ДатаПрайса - Дата - с этой даты действуют цены поставщика.
//   * ЗаписыватьЦеныПоставщика - Булево
//   * ВидЦенПоставщика - СправочникСсылка.ВидыЦенКонтрагентов - если пусто, берётся вид цен поставщика.
//   * ЗаписыватьРРЦ - Булево - колонку РРЦ писать в наш вид цен.
//   * ВидЦенРРЦ - СправочникСсылка.ВидыЦен
//   * ПорогИзменения - Число - изменение цены больше этого процента требует подтверждения.
//   * СоздаватьНовыеТовары - Булево
//   * ГруппаДляНовых - СправочникСсылка.Номенклатура - куда класть новые товары, если не понятно по соседям.
//   * ИмяФайла - Строка - для комментариев и журнала.
//
Функция НовыеПараметры() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Поставщик", Справочники.Контрагенты.ПустаяСсылка());
	Параметры.Вставить("ДатаПрайса", НачалоДня(ТекущаяДатаСеанса()));
	Параметры.Вставить("ЗаписыватьЦеныПоставщика", Истина);
	Параметры.Вставить("ВидЦенПоставщика", Справочники.ВидыЦенКонтрагентов.ПустаяСсылка());
	Параметры.Вставить("ЗаписыватьРРЦ", Истина);
	Параметры.Вставить("ВидЦенРРЦ", Справочники.ВидыЦен.НайтиПоНаименованию("Розничная", Истина));
	Параметры.Вставить("ПорогИзменения", 25);
	Параметры.Вставить("СоздаватьНовыеТовары", Истина);
	Параметры.Вставить("ГруппаДляНовых", Справочники.Номенклатура.ПустаяСсылка());
	Параметры.Вставить("ИмяФайла", "");
	Возврат Параметры;

КонецФункции

// Читает файл прайса в массив строк.
//
// Параметры:
//  ПутьКФайлу - Строка - xlsx, xls, ods, mxl, csv или txt на сервере.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * НомерСтроки - Число - номер строки в файле.
//   * Ячейки - Массив из Строка
//
Функция ПрочитатьФайл(ПутьКФайлу) Экспорт

	Расширение = НРег(РасширениеФайла(ПутьКФайлу));
	Если Расширение = "csv" Или Расширение = "txt" Тогда
		Возврат ПрочитатьCSV(ПутьКФайлу);
	КонецЕсли;

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	Результат = Новый Массив;
	Ширина = ТабличныйДокумент.ШиринаТаблицы;
	Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Для НомерКолонки = 1 По Ширина Цикл
			Ячейки.Добавить(ТекстЯчейки(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки)));
		КонецЦикла;
		УбратьПовторОбъединеннойЯчейки(Ячейки);
		Результат.Добавить(Новый Структура("НомерСтроки, Ячейки", НомерСтроки, Ячейки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разбирает строки файла: находит заголовок, колонки, дату прайса и позиции.
//
// Параметры:
//  СтрокиФайла - см. ПрочитатьФайл.
//  Колонки - Структура, Неопределено - номера колонок, заданные вручную; Неопределено - определить по заголовку.
//  ИмяФайла - Строка - дата прайса ищется и в имени файла.
//
// Возвращаемое значение:
//  Структура:
//   * СтрокаЗаголовка - Число - номер строки файла с заголовками, 0 если не найдена.
//   * Колонки - см. НовыеКолонки.
//   * ДатаПрайса - Дата - пустая, если в файле не указана.
//   * Позиции - ТаблицаЗначений - см. НоваяТаблицаПозиций.
//   * СлужебныхСтрок - Число - пропущенные строки категорий, примечаний и пустые.
//
Функция РазобратьПрайс(СтрокиФайла, Колонки = Неопределено, ИмяФайла = "") Экспорт

	Результат = Новый Структура("СтрокаЗаголовка, Колонки, ДатаПрайса, Позиции, СлужебныхСтрок", 0, НовыеКолонки(), '00010101', НоваяТаблицаПозиций(), 0);

	ИндексЗаголовка = НайтиСтрокуЗаголовка(СтрокиФайла);
	Если ИндексЗаголовка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.СтрокаЗаголовка = СтрокиФайла[ИндексЗаголовка].НомерСтроки;
	Результат.Колонки = ?(Колонки = Неопределено, ОпределитьКолонки(СтрокиФайла[ИндексЗаголовка].Ячейки), Колонки);

	// Дата прайса: в шапке над таблицей или в имени файла.
	Для Индекс = 0 По ИндексЗаголовка - 1 Цикл
		Дата = ДатаИзТекста(СтрСоединить(СтрокиФайла[Индекс].Ячейки, " "));
		Если ЗначениеЗаполнено(Дата) Тогда
			Результат.ДатаПрайса = Дата;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Результат.ДатаПрайса) Тогда
		Результат.ДатаПрайса = ДатаИзТекста(ИмяФайла);
	КонецЕсли;

	К = Результат.Колонки;
	ТекущаяКатегория = "";
	Для Индекс = ИндексЗаголовка + 1 По СтрокиФайла.ВГраница() Цикл
		СтрокаФайла = СтрокиФайла[Индекс];
		Вид = ВидСтроки(СтрокаФайла.Ячейки, К);
		Если Вид = "Категория" Тогда
			ТекущаяКатегория = ПервоеЗначение(СтрокаФайла.Ячейки);
			Результат.СлужебныхСтрок = Результат.СлужебныхСтрок + 1;
			Продолжить;
		ИначеЕсли Вид <> "Позиция" Тогда
			Результат.СлужебныхСтрок = Результат.СлужебныхСтрок + 1;
			Продолжить;
		КонецЕсли;

		Позиция = Результат.Позиции.Добавить();
		Позиция.НомерСтрокиФайла = СтрокаФайла.НомерСтроки;
		Позиция.КодПоставщика = Ячейка(СтрокаФайла.Ячейки, К.КодПоставщика);
		Позиция.Артикул = Ячейка(СтрокаФайла.Ячейки, К.Артикул);
		Позиция.Штрихкод = СтрЗаменить(Ячейка(СтрокаФайла.Ячейки, К.Штрихкод), " ", "");
		Позиция.Наименование = СокрЛП(СтрЗаменить(Ячейка(СтрокаФайла.Ячейки, К.Наименование), Символы.ПС, " "));
		Позиция.Единица = Ячейка(СтрокаФайла.Ячейки, К.Единица);
		Позиция.Категория = ?(К.Категория > 0, Ячейка(СтрокаФайла.Ячейки, К.Категория), ТекущаяКатегория);
		Позиция.ТекстЦены = Ячейка(СтрокаФайла.Ячейки, К.Цена);
		Позиция.Цена = ЧислоИлиНоль(Позиция.ТекстЦены);
		Позиция.РРЦ = ЧислоИлиНоль(Ячейка(СтрокаФайла.Ячейки, К.РРЦ));
		Позиция.Ключ = КлючПозиции(Позиция);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сопоставляет позиции прайса с базой и вычисляет, что изменится. В базу ничего не пишет.
//
// Параметры:
//  Позиции - ТаблицаЗначений - см. НоваяТаблицаПозиций; заполняются колонки сопоставления и статусы.
//  Параметры - см. НовыеПараметры.
//
// Возвращаемое значение:
//  Структура - сводка, см. НоваяСводка.
//
Функция Сопоставить(Позиции, Параметры) Экспорт

	Для Каждого Позиция Из Позиции Цикл
		ОчиститьСопоставление(Позиция);
	КонецЦикла;

	ПроверитьОбязательныеДанные(Позиции);
	ПроверитьПовторыВФайле(Позиции);

	Если ЗначениеЗаполнено(Параметры.Поставщик) Тогда
		НайтиПоСоответствиюПоставщика(Позиции, Параметры.Поставщик);
	КонецЕсли;
	НайтиПоШтрихкоду(Позиции);
	НайтиПоАртикулу(Позиции);
	НайтиПоНаименованию(Позиции);
	ПроверитьПовторыТоваров(Позиции);
	НайтиЕдиницыИзмерения(Позиции);
	ПрочитатьСвойстваТоваров(Позиции);
	ПрочитатьТекущиеЦены(Позиции, Параметры);
	ОпределитьГруппыНовыхТоваров(Позиции, Параметры);

	Для Каждого Позиция Из Позиции Цикл
		ОпределитьСтатус(Позиция, Параметры);
	КонецЦикла;

	Возврат Сводка(Позиции);

КонецФункции

// Загружает отмеченные позиции одной транзакцией.
//
// Параметры:
//  Позиции - ТаблицаЗначений - результат Сопоставить; колонка Результат заполняется.
//  Параметры - см. НовыеПараметры.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * ТекстОшибки - Строка
//   * СозданоТоваров, СозданоСоответствий, ЗаписаноЦенПоставщика, ЗаписаноРРЦ, СозданоШтрихкодов - Число
//   * Документы - Массив из ДокументСсылка.УстановкаЦенНоменклатуры
//
Функция Загрузить(Позиции, Параметры) Экспорт

	Итог = Новый Структура("Успех, ТекстОшибки, СозданоТоваров, СозданоСоответствий, ЗаписаноЦенПоставщика, ЗаписаноРРЦ, СозданоШтрихкодов, Документы, Время",
		Ложь, "", 0, 0, 0, 0, 0, Новый Массив, Новый Структура);
	Замер = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если Не ЗначениеЗаполнено(Параметры.Поставщик) Тогда
		Итог.ТекстОшибки = НСтр("ru = 'Не выбран поставщик.'");
		Возврат Итог;
	КонецЕсли;

	ВидЦенПоставщика = ?(ЗначениеЗаполнено(Параметры.ВидЦенПоставщика), Параметры.ВидЦенПоставщика, ВидЦенПоставщика(Параметры.Поставщик));

	// Новые товары готовим и проверяем до транзакции: строки с ошибками заполнения просто не попадут в загрузку.
	НовыеТовары = ПодготовитьНовыеТовары(Позиции, Параметры);
	Замер = ОтметитьВремя(Итог, "Подготовка", Замер);

	НачатьТранзакцию();
	Попытка

		Если Параметры.ЗаписыватьЦеныПоставщика И Не ЗначениеЗаполнено(ВидЦенПоставщика) Тогда
			ВидЦенПоставщика = СоздатьВидЦенПоставщика(Параметры.Поставщик, Параметры.ВидЦенРРЦ);
		КонецЕсли;

		Для Каждого КлючИЗначение Из НовыеТовары Цикл
			Позиция = КлючИЗначение.Ключ;
			Объект = КлючИЗначение.Значение;
			Объект.Записать();
			Позиция.Номенклатура = Объект.Ссылка;
			// Единицу запоминаем сразу: обращение к реквизиту через точку у товара, созданного в этой же
			// транзакции, в файловой базе стоит около 0,1 с и дорожает по мере роста транзакции.
			Позиция.ЕдиницаТовара = Объект.ЕдиницаИзмерения;
			Итог.СозданоТоваров = Итог.СозданоТоваров + 1;
			Если ЗаписатьШтрихкод(Позиция) Тогда
				Итог.СозданоШтрихкодов = Итог.СозданоШтрихкодов + 1;
			КонецЕсли;
		КонецЦикла;

		Замер = ОтметитьВремя(Итог, "НовыеТовары", Замер);
		Итог.СозданоСоответствий = ЗаписатьСоответствия(Позиции, Параметры.Поставщик);
		Замер = ОтметитьВремя(Итог, "Соответствия", Замер);

		Если Параметры.ЗаписыватьЦеныПоставщика Тогда
			Итог.ЗаписаноЦенПоставщика = ЗаписатьЦеныПоставщика(Позиции, ВидЦенПоставщика, Параметры);
		КонецЕсли;
		Замер = ОтметитьВремя(Итог, "ЦеныПоставщика", Замер);

		Если Параметры.ЗаписыватьРРЦ И ЗначениеЗаполнено(Параметры.ВидЦенРРЦ) Тогда
			Итог.ЗаписаноРРЦ = ЗаписатьРРЦ(Позиции, Параметры, Итог.Документы);
		КонецЕсли;

		Замер = ОтметитьВремя(Итог, "РРЦ", Замер);
		
		// Для автотеста отката: сбой после всех записей, но до фиксации транзакции.
		Если Параметры.Свойство("ИмитироватьСбой") И Параметры.ИмитироватьСбой Тогда
			ВызватьИсключение НСтр("ru = 'Имитация сбоя перед фиксацией транзакции'");
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		Итог.Успех = Истина;

	Исключение
		ОтменитьТранзакцию();
		Итог.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Для Каждого Позиция Из Позиции Цикл
			Если НовыеТовары[Позиция] <> Неопределено Тогда
				Позиция.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
			КонецЕсли;
			Позиция.Результат = "";
		КонецЦикла;
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , Параметры.Поставщик,
			СтрШаблон(НСтр("ru = 'Загрузка прайса отменена, изменения не записаны. Файл: %1. %2'"), Параметры.ИмяФайла,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Итог;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , Параметры.Поставщик,
		СтрШаблон(НСтр("ru = 'Файл: %1. %2'"), Параметры.ИмяФайла, ПредставлениеИтога(Итог)));

	Возврат Итог;

КонецФункции

// Загрузка без формы: для регламентного задания или командной строки.
// Подозрительные изменения цен (статус «Проверить») в пакетном режиме не применяются.
//
// Параметры:
//  ПутьКФайлу - Строка
//  ПутьКОтчету - Строка - текстовый отчёт UTF-8.
//  ИННПоставщика - Строка
//  Порог - Число, Неопределено - порог изменения цены, %.
//
// Возвращаемое значение:
//  Структура - см. Загрузить; Неопределено, если загрузка не дошла до записи.
//
Функция ПакетнаяЗагрузка(ПутьКФайлу, ПутьКОтчету, ИННПоставщика, Порог = Неопределено) Экспорт

	Отчет = Новый Массив;
	Отчет.Добавить("Файл: " + ПутьКФайлу);
	Итог = Неопределено;
	Попытка
		Параметры = НовыеПараметры();
		Параметры.Поставщик = ПоставщикПоИНН(ИННПоставщика);
		Если Не ЗначениеЗаполнено(Параметры.Поставщик) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Поставщик с ИНН %1 не найден.'"), ИННПоставщика);
		КонецЕсли;
		Если Порог <> Неопределено Тогда
			Параметры.ПорогИзменения = Порог;
		КонецЕсли;
		Параметры.ИмяФайла = ИмяФайла(ПутьКФайлу);

		Разбор = РазобратьПрайс(ПрочитатьФайл(ПутьКФайлу), , Параметры.ИмяФайла);
		Если ЗначениеЗаполнено(Разбор.ДатаПрайса) Тогда
			Параметры.ДатаПрайса = Разбор.ДатаПрайса;
		КонецЕсли;
		Отчет.Добавить("Поставщик: " + Параметры.Поставщик + ", дата прайса: " + Формат(Параметры.ДатаПрайса, "ДЛФ=D"));
		Отчет.Добавить("Колонки: " + ПредставлениеКолонок(Разбор.Колонки));

		Сводка = Сопоставить(Разбор.Позиции, Параметры);
		Отчет.Добавить(ПредставлениеСводки(Сводка));
		Итог = Загрузить(Разбор.Позиции, Параметры);
		Отчет.Добавить(?(Итог.Успех, ПредставлениеИтога(Итог), "ЗАГРУЗКА ОТМЕНЕНА: " + Итог.ТекстОшибки));

		Для Каждого Позиция Из Разбор.Позиции Цикл
			Отчет.Добавить(СтрШаблон("стр. %1 | %2 | %3 | %4 | %5 | %6 | %7",
				Позиция.НомерСтрокиФайла, Позиция.Ключ, Позиция.Наименование, Позиция.Статус, Позиция.КакНайден,
				Позиция.Комментарий, Позиция.Результат));
		КонецЦикла;
	Исключение
		Отчет.Добавить("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Отчет, Символы.ПС));
	Текст.Записать(ПутьКОтчету, КодировкаТекста.UTF8);
	Возврат Итог;

КонецФункции

