Функция СодержитОдноИз(Текст, Слова)

	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(Текст, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Заголовок равен слову или начинается с него и пробела/запятой: «Код», «Код,», «Ед. изм» для «ед».
Функция НачинаетсяСоСлова(Текст, Слова)

	Для Каждого Слово Из Слова Цикл
		Если Текст = Слово Или СтрНачинаетсяС(Текст, Слово + " ") Или СтрНачинаетсяС(Текст, Слово + ",")
			Или СтрНачинаетсяС(Текст, Слово + ".") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат Символ >= "0" И Символ <= "9" И Символ <> "";

КонецФункции

Функция Ячейка(Ячейки, НомерКолонки)

	Если НомерКолонки = 0 Или НомерКолонки > Ячейки.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Ячейки[НомерКолонки - 1]);

КонецФункции

Функция ПервоеЗначение(Ячейки)

	Для Каждого Значение Из Ячейки Цикл
		Если Не ПустаяСтрока(Значение) Тогда
			Возврат СокрЛП(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Прочее

// Различные непустые значения колонки для параметра запроса.
Функция ЗначенияКолонки(Позиции, Колонка, БезОшибок = Ложь)

	Значения = Новый Массив;
	Уже = Новый Соответствие;
	Для Каждого Позиция Из Позиции Цикл
		Значение = Позиция[Колонка];
		Если Не ЗначениеЗаполнено(Значение) Или (БезОшибок И Позиция.ЕстьОшибка) Или Уже[Значение] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Значение, Истина);
		Значения.Добавить(Значение);
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Соответствие «нормализованный ключ → массив товаров».
Функция СоответствиеПоКлючу(Таблица, Колонка)

	Результат = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = НормализоватьТекст(СтрокаТаблицы[Колонка]);
		Товары = Результат[Ключ];
		Если Товары = Неопределено Тогда
			Товары = Новый Массив;
			Результат.Вставить(Ключ, Товары);
		КонецЕсли;
		Если Товары.Найти(СтрокаТаблицы.Номенклатура) = Неопределено Тогда
			Товары.Добавить(СтрокаТаблицы.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ОтметитьОшибку(Позиция, Текст)

	Позиция.ЕстьОшибка = Истина;
	Позиция.Применить = Ложь;
	Позиция.Комментарий = ?(ПустаяСтрока(Позиция.Комментарий), Текст, Позиция.Комментарий + "; " + Текст);

КонецПроцедуры

Процедура ДобавитьРезультат(Позиция, Текст)

	Позиция.Результат = ?(ПустаяСтрока(Позиция.Результат), Текст, Позиция.Результат + ", " + Текст);

КонецПроцедуры

Функция ТекстСообщений(Заголовок)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат ?(Тексты.Количество() = 0, Заголовок, Заголовок + ": " + СтрСоединить(Тексты, "; "));

КонецФункции

Функция РасширениеФайла(Путь)

	Части = СтрРазделить(Путь, ".");
	Возврат ?(Части.Количество() > 1, Части[Части.ВГраница()], "");

КонецФункции

Функция ИмяФайла(Путь) Экспорт

	Части = СтрРазделить(СтрЗаменить(Путь, "/", "\"), "\");
	Возврат Части[Части.ВГраница()];

КонецФункции

