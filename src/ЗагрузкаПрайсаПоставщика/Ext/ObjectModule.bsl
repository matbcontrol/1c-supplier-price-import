	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.ЕстьОшибка Или ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Товары = Найденные[НормализоватьТекст(Позиция.Артикул)];
		Если Товары <> Неопределено Тогда
			УстановитьНайденное(Позиция, Товары, "артикул");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура НайтиПоНаименованию(Позиции)

	Искать = Ложь;
	Для Каждого Позиция Из Позиции Цикл
		Если Не Позиция.ЕстьОшибка И Не ЗначениеЗаполнено(Позиция.Номенклатура) И Не ПустаяСтрока(Позиция.Наименование) Тогда
			Искать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не Искать Тогда
		Возврат;
	КонецЕсли;

	// Наименования в базе бывают с двойными пробелами и «ё», поэтому сравниваем нормализованные строки.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Наименование КАК Ключ,
	|	Н.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления";
	Найденные = СоответствиеПоКлючу(Запрос.Выполнить().Выгрузить(), "Ключ");

	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.ЕстьОшибка Или ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Товары = Найденные[НормализоватьТекст(Позиция.Наименование)];
		Если Товары <> Неопределено Тогда
			УстановитьНайденное(Позиция, Товары, "наименование");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьНайденное(Позиция, Товары, Способ)

	Если Товары.Количество() > 1 Тогда
		ОтметитьОшибку(Позиция, СтрШаблон(НСтр("ru = 'по полю «%1» в базе несколько товаров (%2), нужно выбрать вручную'"),
			Способ, Товары.Количество()));
		Возврат;
	КонецЕсли;
	Позиция.Номенклатура = Товары[0];
	Позиция.КакНайден = Способ;

КонецПроцедуры

Процедура ПроверитьПовторыТоваров(Позиции)

	Первые = Новый Соответствие;
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.ЕстьОшибка Или Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Первая = Первые[Позиция.Номенклатура];
		Если Первая = Неопределено Тогда
			Первые.Вставить(Позиция.Номенклатура, Позиция.НомерСтрокиФайла);
		Иначе
			ОтметитьОшибку(Позиция, СтрШаблон(НСтр("ru = 'этот товар уже сопоставлен строке %1 прайса'"), Формат(Первая, "ЧГ=")));
		КонецЕсли;
