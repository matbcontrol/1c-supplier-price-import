#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПараметрыПоУмолчанию = РеквизитФормыВЗначение("Объект").НовыеПараметры();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыПоУмолчанию,
		"ДатаПрайса, ЗаписыватьЦеныПоставщика, ЗаписыватьРРЦ, ВидЦенРРЦ, ПорогИзменения, СоздаватьНовыеТовары");

	Показать = "Все";
	Для Каждого Вариант Из СтрРазделить("Все,Новый,Изменение цены,Проверить,Ошибка,Нет цены,Без изменений", ",") Цикл
		Элементы.Показать.СписокВыбора.Добавить(Вариант);
	КонецЦикла;

	НастроитьУсловноеОформление();

	// Пустые цены и проценты не показываем нулями.
	Для Каждого Имя Из СтрРазделить("ПозицииЦенаБыло,ПозицииЦена,ПозицииРРЦБыло,ПозицииРРЦ", ",") Цикл
		Элементы[Имя].Формат = "ЧДЦ=2; ЧН=' '";
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ПозицииЦенаИзменение,ПозицииРРЦИзменение", ",") Цикл
		Элементы[Имя].Формат = "ЧДЦ=1; ЧН=' '";
	КонецЦикла;
	Элементы.Сводка.Ширина = 150;
	Элементы.Сводка.РастягиватьПоГоризонтали = Истина;
	Элементы.Показать.РастягиватьПоГоризонтали = Ложь;
	Сводка = НСтр("ru = 'Выберите поставщика и файл прайса. Пока вы не нажмёте «Загрузить», в базе ничего не меняется.'");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Пакетная загрузка, например по расписанию:
	// 1cv8.exe ENTERPRISE /F <база> /Execute ЗагрузкаПрайсаПоставщика.epf /C "ЗагрузкаПрайса;<файл>;<отчёт>;<ИНН поставщика>"
	// Открыть форму сразу с прайсом: /C "ОткрытьПрайс;<файл>;<ИНН поставщика>[;<статус для отбора>]"
	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() >= 4 И Части[0] = "ЗагрузкаПрайса" Тогда
		ПакетнаяЗагрузкаНаСервере(Части[1], Части[2], Части[3]);
		ПодключитьОбработчикОжидания("ЗавершитьРаботуПослеПакетнойЗагрузки", 0.1, Истина);
	ИначеЕсли Части.Количество() >= 3 И Части[0] = "ОткрытьПрайс" Тогда
		ОткрытьПрайсНаСервере(Части[1], Части[2]);
		Если Части.Количество() >= 4 Тогда
			Показать = Части[3];
			ПрименитьОтбор();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПараметрыДиалога = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыДиалога.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыДиалога.Диалог.Заголовок = НСтр("ru = 'Прайс-лист поставщика'");
	ПараметрыДиалога.Диалог.Фильтр = НСтр("ru = 'Прайс-листы (*.xlsx;*.xls;*.ods;*.csv)|*.xlsx;*.xls;*.ods;*.csv|Все файлы (*.*)|*.*'");
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект), ПараметрыДиалога);

КонецПроцедуры

&НаКлиенте
Процедура ПоставщикПриИзменении(Элемент)

	ПоставщикПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПараметрПриИзменении(Элемент)

	Если ЗначениеЗаполнено(АдресСтрок) Тогда
		СопоставитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КолонкаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(АдресСтрок) Тогда
		РазобратьНаСервере(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)

	Если Позиции.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите файл прайса.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите поставщика: к нему привязываются цены и соответствия товаров.'"));
		Возврат;
	КонецЕсли;
	Если ЗагрузкаВыполнена Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Этот прайс уже загружен. Нажмите «Перечитать прайс», чтобы сверить его с базой заново.'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьПослеПодтверждения", ЭтотОбъект), ТекстПодтверждения(),
		РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.Отмена);

КонецПроцедуры

&НаКлиенте
Процедура Перечитать(Команда)

	Если ЗначениеЗаполнено(АдресСтрок) Тогда
		РазобратьНаСервере(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораФайла(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьФайлНаСервере(ПомещенныйФайл.Хранение, ПомещенныйФайл.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	Если ЗагрузитьНаСервере() Тогда
		ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));
		ПоказатьОповещениеПользователя(НСтр("ru = 'Прайс загружен'"), , Сводка);
	Иначе
		ПоказатьПредупреждение(, Сводка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ТекстПодтверждения()

	Новых = 0;
	ЦенПоставщика = 0;
	РРЦ = 0;
	ПодтвержденоВручную = 0;
	НеПодтверждено = 0;
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.Статус = "Проверить" И Не Позиция.Применить Тогда
			НеПодтверждено = НеПодтверждено + 1;
		КонецЕсли;
		Если Не Позиция.Применить Тогда
			Продолжить;
		КонецЕсли;
		Новых = Новых + ?(Позиция.Статус = "Новый", 1, 0);
		ПодтвержденоВручную = ПодтвержденоВручную + ?(Позиция.Статус = "Проверить", 1, 0);
		ЦенПоставщика = ЦенПоставщика + ?(ЗаписыватьЦеныПоставщика И Позиция.ИзменитсяЦена, 1, 0);
		РРЦ = РРЦ + ?(ЗаписыватьРРЦ И Позиция.ИзменитсяРРЦ, 1, 0);
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Поставщик: %1, прайс от %2.'"), Поставщик, Формат(ДатаПрайса, "ДЛФ=D")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Создать новых товаров: %1.'"), Новых));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Записать цен поставщика: %1, РРЦ: %2.'"), ЦенПоставщика, РРЦ));
	Если ПодтвержденоВручную > 0 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Из них подтверждено вами вручную: %1.'"), ПодтвержденоВручную));
	КонецЕсли;
	Если НеПодтверждено > 0 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Позиции «Проверить» без отметки (%1) загружены не будут.'"), НеПодтверждено));
	КонецЕсли;
	Строки.Добавить(НСтр("ru = 'Загрузка идёт одной транзакцией: при ошибке в базе ничего не изменится. Продолжить?'"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура ПрименитьОтбор()

	Если ПустаяСтрока(Показать) Или Показать = "Все" Тогда
		Элементы.Позиции.ОтборСтрок = Неопределено;
	Иначе
		Элементы.Позиции.ОтборСтрок = Новый ФиксированнаяСтруктура("Статус", Показать);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуПослеПакетнойЗагрузки() Экспорт

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресФайла, ПолноеИмяФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Обработка = РеквизитФормыВЗначение("Объект");
	ИмяФайла = Обработка.ИмяФайла(ПолноеИмяФайла);
	Части = СтрРазделить(ИмяФайла, ".");
	ВременныйФайл = ПолучитьИмяВременногоФайла(?(Части.Количество() > 1, Части[Части.ВГраница()], "xlsx"));
	ДвоичныеДанные.Записать(ВременныйФайл);
	Попытка
		СтрокиФайла = Обработка.ПрочитатьФайл(ВременныйФайл);
	Исключение
		УдалитьФайлы(ВременныйФайл);
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось прочитать файл «%1»: %2'"), ИмяФайла, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьФайлы(ВременныйФайл);

	АдресСтрок = ПоместитьВоВременноеХранилище(СтрокиФайла, УникальныйИдентификатор);
	РазобратьНаСервере(Истина);

КонецПроцедуры

&НаСервере
Процедура ОткрытьПрайсНаСервере(ПутьКФайлу, ИННПоставщика)

	Обработка = РеквизитФормыВЗначение("Объект");
	Поставщик = Обработка.ПоставщикПоИНН(ИННПоставщика);
	ВидЦенПоставщика = Обработка.ВидЦенПоставщика(Поставщик);
	ИмяФайла = Обработка.ИмяФайла(ПутьКФайлу);
	АдресСтрок = ПоместитьВоВременноеХранилище(Обработка.ПрочитатьФайл(ПутьКФайлу), УникальныйИдентификатор);
	РазобратьНаСервере(Истина);

КонецПроцедуры

&НаСервере
Процедура РазобратьНаСервере(ОпределятьКолонки)

	Обработка = РеквизитФормыВЗначение("Объект");
	СтрокиФайла = ПолучитьИзВременногоХранилища(АдресСтрок);

	Колонки = Неопределено;
	Если Не ОпределятьКолонки Тогда
		Колонки = Обработка.НовыеКолонки();
		Для Каждого КлючИЗначение Из Колонки Цикл
			Колонки[КлючИЗначение.Ключ] = ЭтотОбъект["Колонка" + КлючИЗначение.Ключ];
		КонецЦикла;
	КонецЕсли;

	Разбор = Обработка.РазобратьПрайс(СтрокиФайла, Колонки, ИмяФайла);
	Для Каждого КлючИЗначение Из Разбор.Колонки Цикл
		ЭтотОбъект["Колонка" + КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
	Если ОпределятьКолонки И ЗначениеЗаполнено(Разбор.ДатаПрайса) Тогда
		ДатаПрайса = Разбор.ДатаПрайса;
	КонецЕсли;
	ЗагрузкаВыполнена = Ложь;

	СопоставитьНаСервере(Разбор);

КонецПроцедуры

&НаСервере
Процедура СопоставитьНаСервере(Разбор = Неопределено)

	Обработка = РеквизитФормыВЗначение("Объект");
	ТаблицаПозиций = ?(Разбор = Неопределено, РеквизитФормыВЗначение("Позиции"), Разбор.Позиции);
	ИтогСопоставления = Обработка.Сопоставить(ТаблицаПозиций, ПараметрыЗагрузки());
	ЗначениеВРеквизитФормы(ТаблицаПозиций, "Позиции");

	Строки = Новый Массив;
	Если Разбор <> Неопределено Тогда
		Если Разбор.СтрокаЗаголовка = 0 Тогда
			Строки.Добавить(НСтр("ru = 'Не нашли строку заголовков: укажите номера колонок вручную и нажмите «Перечитать прайс».'"));
		Иначе
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Заголовки в строке %1, пропущено строк шапки, разделов и примечаний: %2. Дата прайса: %3.'"),
				Разбор.СтрокаЗаголовка, Разбор.СлужебныхСтрок,
				?(ЗначениеЗаполнено(Разбор.ДатаПрайса), Формат(Разбор.ДатаПрайса, "ДЛФ=D") + НСтр("ru = ' (из файла)'"), НСтр("ru = 'в файле не указана, проверьте'"))));
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		Строки.Добавить(НСтр("ru = 'Поставщик не выбран: цены поставщика не сравниваются, сохранённые соответствия не используются.'"));
	КонецЕсли;
	Строки.Добавить(Обработка.ПредставлениеСводки(ИтогСопоставления));
	Сводка = СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция ЗагрузитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ТаблицаПозиций = РеквизитФормыВЗначение("Позиции");
	Итог = Обработка.Загрузить(ТаблицаПозиций, ПараметрыЗагрузки());
	ЗначениеВРеквизитФормы(ТаблицаПозиций, "Позиции");
	Если Итог.Успех Тогда
		ЗагрузкаВыполнена = Истина;
		Сводка = НСтр("ru = 'Загружено. '") + Обработка.ПредставлениеИтога(Итог)
			+ Символы.ПС + НСтр("ru = 'Что записано по каждой позиции - в колонке «Комментарий». Запись о загрузке есть в журнале регистрации.'");
		Для Каждого Позиция Из Позиции Цикл
			Если Не ПустаяСтрока(Позиция.Результат) Тогда
				Позиция.Комментарий = НСтр("ru = 'Записано: '") + Позиция.Результат;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Сводка = НСтр("ru = 'Загрузка отменена, в базе ничего не изменилось. Причина: '") + Итог.ТекстОшибки;
	КонецЕсли;
	Возврат Итог.Успех;

КонецФункции

&НаСервере
Процедура ПакетнаяЗагрузкаНаСервере(ПутьКФайлу, ПутьКОтчету, ИННПоставщика)

	РеквизитФормыВЗначение("Объект").ПакетнаяЗагрузка(ПутьКФайлу, ПутьКОтчету, ИННПоставщика, ПорогИзменения);

КонецПроцедуры

&НаСервере
Процедура ПоставщикПриИзмененииНаСервере()

	ВидЦенПоставщика = РеквизитФормыВЗначение("Объект").ВидЦенПоставщика(Поставщик);
	Если ЗначениеЗаполнено(АдресСтрок) Тогда
		СопоставитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПараметрыЗагрузки()

	ПараметрыФормы = РеквизитФормыВЗначение("Объект").НовыеПараметры();
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ЭтотОбъект,
		"Поставщик, ДатаПрайса, ЗаписыватьЦеныПоставщика, ВидЦенПоставщика, ЗаписыватьРРЦ, ВидЦенРРЦ, ПорогИзменения, СоздаватьНовыеТовары, ГруппаДляНовых, ИмяФайла");
	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		ПараметрыФормы.ЗаписыватьЦеныПоставщика = Ложь;
	КонецЕсли;
	Возврат ПараметрыФормы;

КонецФункции

&НаСервере
Процедура НастроитьУсловноеОформление()

	ДобавитьЦветСтатуса("Ошибка", Новый Цвет(192, 0, 0));
	ДобавитьЦветСтатуса("Проверить", Новый Цвет(196, 98, 0));
	ДобавитьЦветСтатуса("Новый", Новый Цвет(0, 128, 0));
	ДобавитьЦветСтатуса("Изменение цены", Новый Цвет(0, 80, 170));
	ДобавитьЦветСтатуса("Без изменений", Новый Цвет(130, 130, 130));
	ДобавитьЦветСтатуса("Нет цены", Новый Цвет(130, 130, 130));
	ДобавитьЦветСтатуса("Пропущен", Новый Цвет(130, 130, 130));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЦветСтатуса(Статус, Цвет)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Для Каждого Имя Из СтрРазделить("ПозицииСтатус,ПозицииКомментарий", ",") Цикл
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Имя);
	КонецЦикла;
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Позиции.Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Цвет);

КонецПроцедуры

