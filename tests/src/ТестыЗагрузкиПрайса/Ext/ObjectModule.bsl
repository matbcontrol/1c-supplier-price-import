#Область Вспомогательные

Функция ПараметрыАльфамарт()

	Параметры = Обработка.НовыеПараметры();
	Параметры.Поставщик = Обработка.ПоставщикПоИНН("6670365488");
	Возврат Параметры;

КонецФункции

Функция Разобрать(Файл, Параметры)

	Параметры.ИмяФайла = Обработка.ИмяФайла(Файл);
	Разбор = Обработка.РазобратьПрайс(Обработка.ПрочитатьФайл(Файл), , Параметры.ИмяФайла);
	Если ЗначениеЗаполнено(Разбор.ДатаПрайса) Тогда
		Параметры.ДатаПрайса = Разбор.ДатаПрайса;
	КонецЕсли;
	Возврат Разбор;

КонецФункции

Функция НайтиПозицию(Разбор, НачалоНаименования)

	Для Каждого Позиция Из Разбор.Позиции Цикл
		Если СтрНачинаетсяС(Позиция.Наименование, НачалоНаименования) Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет позиции " + НачалоНаименования;

КонецФункции

Функция ПозицияПоКлючу(Разбор, Ключ)

	Позиция = Разбор.Позиции.Найти(Ключ, "Ключ");
	Если Позиция = Неопределено Тогда
		ВызватьИсключение "Нет позиции с кодом " + Ключ;
	КонецЕсли;
	Возврат Позиция;

КонецФункции

Функция Число1(ТекстЗапроса, Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено)

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("П1", Параметр1);
	Запрос.УстановитьПараметр("П2", Параметр2);
	Запрос.УстановитьПараметр("П3", Параметр3);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка[0], Неопределено);

КонецФункции

Функция ПредставлениеВремени(Время)
	
	Части = Новый Массив;
	Для Каждого КлючИЗначение Из Время Цикл
		Части.Добавить(КлючИЗначение.Ключ + " " + Формат(КлючИЗначение.Значение / 1000, "ЧДЦ=1; ЧН=0") + " с");
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

Функция ПрочитатьОжидаемое(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь, "UTF-8");
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

Процедура Раздел(Название)

	ЗакрытьРаздел();
	Строки.Добавить("");
	Строки.Добавить(Название);
	НачалоРаздела = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СохранитьОтчет(Ложь);

КонецПроцедуры

Процедура ЗакрытьРаздел()

	Если НачалоРаздела <> Неопределено Тогда
		Строки.Добавить("  (" + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРаздела) / 1000, "ЧДЦ=1; ЧН=0") + " с)");
		НачалоРаздела = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Отчёт пишется после каждого раздела: если прогон прервётся, видно, где.
Процедура СохранитьОтчет(Итоговый)

	Заголовок = СтрШаблон("Проверок: %1, пройдено: %2, не пройдено: %3. Время: %4 с.%5",
		Пройдено + Провалено, Пройдено, Провалено, Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПрогона) / 1000, "ЧДЦ=1; ЧН=0"),
		?(Итоговый, "", " (прогон идёт)"));
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Заголовок + Символы.ПС + СтрСоединить(Строки, Символы.ПС));
	Текст.Записать(ФайлОтчета, КодировкаТекста.UTF8);

КонецПроцедуры

Процедура Проверить(Название, Фактически, Ожидается)

	Если Фактически = Ожидается Тогда
		Пройдено = Пройдено + 1;
		Строки.Добавить("  ok    " + Название);
	Иначе
		Провалено = Провалено + 1;
		Строки.Добавить("  FAIL  " + Название + ": ожидалось «" + Ожидается + "», получено «" + Фактически + "»");
	КонецЕсли;

КонецПроцедуры

