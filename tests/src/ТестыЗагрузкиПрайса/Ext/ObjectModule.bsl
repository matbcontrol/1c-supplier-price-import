// Автотесты обработки «Загрузка прайса поставщика».
//
// Запуск через tools/test.ps1: он восстанавливает демобазу из эталона до и после прогона,
// поэтому тесты записи могут свободно менять данные.
// 1cv8.exe ENTERPRISE /F <база> /Execute ТестыЗагрузкиПрайса.epf /C "Тесты;<обработка.epf>;<каталог price-import>;<отчёт.txt>;СЗаписью"
//
// Ожидаемые числа берутся из samples/gen/expected.json: их считает генератор прайсов по смыслу данных,
// независимо от кода обработки.

Перем Обработка;
Перем Строки;
Перем Пройдено;
Перем Провалено;
Перем ФайлОтчета;
Перем НачалоПрогона;
Перем НачалоРаздела;

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ВыполнитьВсе(ПутьКОбработке, Каталог, ПутьКОтчету, РазрешенаЗапись = Ложь, ТолькоОбъем = Ложь) Экспорт

	Строки = Новый Массив;
	Пройдено = 0;
	Провалено = 0;
	ФайлОтчета = ПутьКОтчету;
	НачалоПрогона = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Обработка = ВнешниеОбработки.Создать(ПутьКОбработке, Ложь);
		Ожидается = ПрочитатьОжидаемое(Каталог + "\samples\gen\expected.json");

		// Объём проверяется отдельным прогоном: создание сотен товаров в УНФ идёт минутами.
		Если ТолькоОбъем Тогда
			Раздел("Объём: прайс на 1000 позиций");
			ТестОбъема(Каталог + "\tests\data\Прайс 1000 позиций.csv");
			ЗакрытьРаздел();
			СохранитьОтчет(Истина);
			Возврат Провалено = 0;
		КонецЕсли;

		Раздел("Разбор чисел и дат");
		ТестыЧисел();
		ТестыДат();
		Раздел("Распознавание прайса");
		ТестыКолонок();
		ТестыСтрок();
		ТестыТекста();

		Если Не РазрешенаЗапись Тогда
			Строки.Добавить("");
			Строки.Добавить("Тесты записи в базу пропущены: их запускает только tools/test.ps1, который восстанавливает базу из эталона до и после прогона.");
		Иначе
			Прайсы = Каталог + "\samples\прайсы\";
			Раздел("Первая загрузка прайса от 13.11.2026");
			ТестПервойЗагрузки(Прайсы + "Прайс АЛЬФАМАРТ от 13.11.2026.xlsx", Ожидается.v1);
			Раздел("Повторная загрузка того же прайса");
			ТестПовторнойЗагрузки(Прайсы + "Прайс АЛЬФАМАРТ от 13.11.2026.xlsx", Ожидается.v1);
			Раздел("Прайс через неделю: ошибка поставщика и распродажа");
			ТестВторогоПрайса(Прайсы + "Прайс АЛЬФАМАРТ от 20.11.2026.xlsx", Ожидается.v2);
			Раздел("Тот же прайс в CSV (Windows-1251) даёт те же данные, что xlsx");
			ТестCSV(Прайсы + "Прайс АЛЬФАМАРТ от 20.11.2026.xlsx", Прайсы + "Прайс АЛЬФАМАРТ от 20.11.2026.csv");
			Раздел("Сбой посреди загрузки: в базе не остаётся половины");
			ТестОтката();
		КонецЕсли;
	Исключение
		Провалено = Провалено + 1;
		Строки.Добавить("СБОЙ ТЕСТОВ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьРаздел();
	СохранитьОтчет(Истина);
	Возврат Провалено = 0;

КонецФункции

#Область ТестыРазбора

Процедура ТестыЧисел()

	Проверить("«1 234,50» → 1234.5", Обработка.ЧислоИзСтроки("1 234,50"), 1234.5);
	Проверить("неразрывный пробел «2 450,00» → 2450", Обработка.ЧислоИзСтроки("2" + Символы.НПП + "450,00"), 2450);
	Проверить("«650.5» → 650.5", Обработка.ЧислоИзСтроки("650.5"), 650.5);
	Проверить("американский «1,234.50» → 1234.5", Обработка.ЧислоИзСтроки("1,234.50"), 1234.5);
	Проверить("европейский «1.234,50» → 1234.5", Обработка.ЧислоИзСтроки("1.234,50"), 1234.5);
	Проверить("«890 ₽» → 890", Обработка.ЧислоИзСтроки("890 ₽"), 890);
	Проверить("«1 150 руб.» → 1150", Обработка.ЧислоИзСтроки("1 150 руб."), 1150);
	Проверить("«по запросу» - не число", Обработка.ЧислоИзСтроки("по запросу"), Неопределено);
	Проверить("«12,5,3» - не число", Обработка.ЧислоИзСтроки("12,5,3"), Неопределено);
	Проверить("пустая строка - не число", Обработка.ЧислоИзСтроки(""), Неопределено);

КонецПроцедуры

Процедура ТестыДат()

	Проверить("дата из шапки «Прайс-лист от 13.11.2026»", Обработка.ДатаИзТекста("Прайс-лист от 13.11.2026"), Дата(2026, 11, 13));
	Проверить("дата из имени файла", Обработка.ДатаИзТекста("Прайс АЛЬФАМАРТ от 20.11.2026.csv"), Дата(2026, 11, 20));
	Проверить("двузначный год «с 01.12.26»", Обработка.ДатаИзТекста("Цены действуют с 01.12.26"), Дата(2026, 12, 1));
	Проверить("«31.02.2026» - не дата", Обработка.ДатаИзТекста("31.02.2026"), '00010101');
	Проверить("номер версии «1.2.3» - не дата", Обработка.ДатаИзТекста("версия 1.2.3"), '00010101');

КонецПроцедуры

Процедура ТестыКолонок()

	К = Обработка.ОпределитьКолонки(СтрРазделить("№|Код|Артикул|Штрихкод|Наименование|Ед.|Цена опт, руб.|РРЦ, руб.|Остаток", "|"));
	Проверить("заголовок прайса: код, артикул, штрихкод", Строка(К.КодПоставщика) + Строка(К.Артикул) + Строка(К.Штрихкод), "234");
	Проверить("заголовок прайса: наименование, ед., цена опт, РРЦ", Строка(К.Наименование) + Строка(К.Единица) + Строка(К.Цена) + Строка(К.РРЦ), "5678");

	К = Обработка.ОпределитьКолонки(СтрРазделить("Наименование товара|Цена розничная|Цена оптовая|Ед. изм.", "|"));
	Проверить("«Цена розничная» - это РРЦ, «Цена оптовая» - цена поставщика", Строка(К.Наименование) + Строка(К.РРЦ) + Строка(К.Цена) + Строка(К.Единица), "1234");

	К = Обработка.ОпределитьКолонки(СтрРазделить("Код товара|Штрих-код|Название|Стоимость|Группа товаров", "|"));
	Проверить("«Код товара», «Штрих-код», «Стоимость», «Группа товаров»", Строка(К.КодПоставщика) + Строка(К.Штрихкод) + Строка(К.Наименование) + Строка(К.Цена) + Строка(К.Категория), "12345");

	Матрица = Новый Массив;
	Для Каждого Текст Из СтрРазделить("ООО «Ромашка»|Оптовая торговля хозяйственными товарами|Прайс от 01.12.2026||№;Код;Наименование;Цена;Ед.|1;А-1;Ведро;100;шт", "|") Цикл
		Матрица.Добавить(Новый Структура("НомерСтроки, Ячейки", Матрица.Количество() + 1, СтрРазделить(Текст, ";")));
	КонецЦикла;
	Проверить("строка заголовков ниже шапки поставщика", Обработка.НайтиСтрокуЗаголовка(Матрица), 4);
	Разбор = Обработка.РазобратьПрайс(Матрица);
	Проверить("дата прайса берётся из шапки", Разбор.ДатаПрайса, Дата(2026, 12, 1));
	Проверить("позиции после заголовка", Разбор.Позиции.Количество(), 1);

КонецПроцедуры

Процедура ТестыСтрок()

	К = Обработка.НовыеКолонки();
	К.КодПоставщика = 2;
	К.Наименование = 3;
	К.Цена = 4;
	Проверить("строка раздела", Обработка.ВидСтроки(СтрРазделить("Ведра, тазы, корыта|||", "|"), К), "Категория");
	Проверить("примечание в конце прайса", Обработка.ВидСтроки(СтрРазделить("Цены действительны 14 дней, уточняйте у менеджера.|||", "|"), К), "Служебная");
	Проверить("строка товара", Обработка.ВидСтроки(СтрРазделить("1|АМ-1|Ведро|100", "|"), К), "Позиция");
	Проверить("пустая строка", Обработка.ВидСтроки(СтрРазделить("|||", "|"), К), "Пустая");

	Ячейки = Обработка.РазобратьСтрокуCSV("""Молоко """"Домик"""", 1 л"";89,90", ";");
	Проверить("CSV: кавычки и разделитель внутри кавычек", Ячейки[0] + "|" + Ячейки[1], "Молоко ""Домик"", 1 л|89,90");
	Ячейки = Обработка.РазобратьСтрокуCSV("Мешки ПРОФИ ""Концепция быта"";99", ";");
	Проверить("CSV: кавычки посреди поля без обрамления остаются в названии", Ячейки[0] + "|" + Ячейки[1], "Мешки ПРОФИ ""Концепция быта""|99");

КонецПроцедуры

Процедура ТестыТекста()

	Проверить("двойные пробелы и регистр в наименовании",
		Обработка.НормализоватьТекст("Доска гладильная  НИКА 10+ (МЕТАЛЛ)"), Обработка.НормализоватьТекст("доска гладильная ника 10+ (металл)"));
	Проверить("«ё» и точка в конце", Обработка.НормализоватьТекст("Ёршик для унитаза."), "ершик для унитаза");
	Проверить("«ёлочки», ""лапки"" и пробел перед запятой не мешают найти товар",
		Обработка.НормализоватьТекст("Корзина для хранения ""ВЕЛЕТТА"", 21*11*5 см"),
		Обработка.НормализоватьТекст("Корзина для хранения «ВЕЛЕТТА» , 21*11*5 см"));
	Проверить("сдвиг запятой распознан как ошибка в прайсе", СтрНайти(Обработка.ОписаниеИзменения(178.64, 1786.4), "в 10,0 раза") > 0, Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыЗагрузки

Процедура ТестПервойЗагрузки(Файл, Ожидается)

	Параметры = ПараметрыАльфамарт();
	Разбор = Разобрать(Файл, Параметры);
	Проверить("дата прайса из шапки", Параметры.ДатаПрайса, Дата(2026, 11, 13));
	Проверить("позиций в прайсе", Разбор.Позиции.Количество(), Ожидается.rows);

	Сводка = Обработка.Сопоставить(Разбор.Позиции, Параметры);
	Проверить("найдено по штрихкоду", Сводка.ПоШтрихкоду, Ожидается.byBarcode);
	Проверить("найдено по артикулу", Сводка.ПоАртикулу, Ожидается.byArticle);
	Проверить("найдено по наименованию", Сводка.ПоНаименованию, Ожидается.byName);
	Проверить("новых товаров", Сводка.Новых, Ожидается.newItems);
	Проверить("изменение цены", Сводка.ИзмененийЦен, Ожидается.changed);
	Проверить("без изменений", Сводка.БезИзменений, Ожидается.unchanged);
	Проверить("ошибок (повтор, единица «рул», характеристика)", Сводка.Ошибок, Ожидается.errors);
	Проверить("«по запросу» вместо цены", Сводка.НетЦены, Ожидается.noPrice);
	Проверить("подозрительных изменений нет", Сводка.Проверить, 0);
	Проверить("перчатки: понятная ошибка про характеристику", СтрНайти(НайтиПозицию(Разбор, "Перчатки").Комментарий, "характеристика") > 0, Истина);

	Итог = Обработка.Загрузить(Разбор.Позиции, Параметры);
	Строки.Добавить("  время записи: " + ПредставлениеВремени(Итог.Время));
	Проверить("загрузка прошла", Итог.Успех, Истина);
	Проверить("создано товаров", Итог.СозданоТоваров, Ожидается.newItems);
	Проверить("создано штрихкодов новых товаров", Итог.СозданоШтрихкодов, Ожидается.newItems);
	Проверить("создано соответствий поставщика", Итог.СозданоСоответствий, Ожидается.mappings);
	Проверить("записано цен поставщика", Итог.ЗаписаноЦенПоставщика, Ожидается.supplierWrites);
	Проверить("записано РРЦ", Итог.ЗаписаноРРЦ, Ожидается.rrpWrites);
	Проверить("документ установки цен один", Итог.Документы.Количество(), 1);

	// Проверяем базу, а не отчёт обработки.
	Проверить("в базе: соответствий поставщика", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Справочник.НоменклатураПоставщиков ГДЕ Владелец = &П1", Параметры.Поставщик), Ожидается.mappings);
	Проверить("в базе: цен поставщика от 13.11.2026", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ЦеныНоменклатурыКонтрагентов ГДЕ Период = ДАТАВРЕМЯ(2026, 11, 13) И ВидЦенКонтрагента.Владелец = &П1", Параметры.Поставщик), Ожидается.supplierWrites);
	Проверить("в базе: строк в документе РРЦ", Итог.Документы[0].Запасы.Количество(), Ожидается.rrpWrites);
	Проверить("в базе: документ РРЦ проведён", Итог.Документы[0].Проведен, Истина);

	Новый1 = Справочники.Номенклатура.НайтиПоНаименованию("Стремянка стальная, 5 ступеней", Истина);
	Проверить("новый товар создан", ЗначениеЗаполнено(Новый1), Истина);
	Если ЗначениеЗаполнено(Новый1) Тогда
		Проверить("новый товар положен к соседям по прайсу", Строка(Новый1.Родитель), "Стремянки");
		Проверить("категория взята у соседа, а не «Мебельные детали»", Строка(Новый1.КатегорияНоменклатуры) <> "Мебельные детали", Истина);
		Проверить("у нового товара указан поставщик", Новый1.Поставщик, Параметры.Поставщик);
		Проверить("штрихкод нового товара записан", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ШтрихкодыНоменклатуры ГДЕ Номенклатура = &П1", Новый1), 1);
	КонецЕсли;
	Проверить("строка с ошибкой не создала товар", ЗначениеЗаполнено(Справочники.Номенклатура.НайтиПоНаименованию("Мешки для мусора 60 л, 20 шт", Истина)), Ложь);

КонецПроцедуры

Процедура ТестПовторнойЗагрузки(Файл, Ожидается)

	Параметры = ПараметрыАльфамарт();
	Разбор = Разобрать(Файл, Параметры);
	Сводка = Обработка.Сопоставить(Разбор.Позиции, Параметры);
	Проверить("все известные товары найдены по запомненному соответствию", Сводка.ПоСоответствию, Ожидается.mappings);
	Проверить("по артикулу ищется только товар с ошибкой", Сводка.ПоАртикулу, 1);
	Проверить("новых товаров нет", Сводка.Новых, 0);
	Проверить("изменений нет", Сводка.ИзмененийЦен, 0);

	ДокументовДо = Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.УстановкаЦенНоменклатуры");
	Итог = Обработка.Загрузить(Разбор.Позиции, Параметры);
	Проверить("повторная загрузка прошла", Итог.Успех, Истина);
	Проверить("ничего не создано", Итог.СозданоТоваров + Итог.СозданоСоответствий + Итог.СозданоШтрихкодов, 0);
	Проверить("ничего не записано", Итог.ЗаписаноЦенПоставщика + Итог.ЗаписаноРРЦ, 0);
	Проверить("лишних документов цен нет", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.УстановкаЦенНоменклатуры"), ДокументовДо);

КонецПроцедуры

Процедура ТестВторогоПрайса(Файл, Ожидается)

	Параметры = ПараметрыАльфамарт();
	Разбор = Разобрать(Файл, Параметры);
	Проверить("дата второго прайса", Параметры.ДатаПрайса, Дата(2026, 11, 20));
	Сводка = Обработка.Сопоставить(Разбор.Позиции, Параметры);
	Проверить("найдено по соответствию поставщика", Сводка.ПоСоответствию, Ожидается.bySupplierMapping);
	Проверить("новых товаров", Сводка.Новых, Ожидается.newItems);
	Проверить("изменение цены", Сводка.ИзмененийЦен, Ожидается.changed);
	Проверить("без изменений", Сводка.БезИзменений, Ожидается.unchanged);
	Проверить("требуют проверки", Сводка.Проверить, Ожидается.check);

	Ошибка = ПозицияПоКлючу(Разбор, Ожидается.decimalSlipCode);
	Проверить("сдвиг запятой: статус «Проверить»", Ошибка.Статус, "Проверить");
	Проверить("сдвиг запятой: не отмечен к загрузке", Ошибка.Применить, Ложь);
	Проверить("сдвиг запятой: объяснение «в 10,0 раза»", СтрНайти(Ошибка.Комментарий, "в 10,0 раза") > 0, Истина);
	Распродажа = ПозицияПоКлючу(Разбор, Ожидается.saleCode);
	Проверить("снижение на 45 %: статус «Проверить»", Распродажа.Статус, "Проверить");

	Итог = Обработка.Загрузить(Разбор.Позиции, Параметры);
	Строки.Добавить("  время записи: " + ПредставлениеВремени(Итог.Время));
	Проверить("загрузка прошла", Итог.Успех, Истина);
	Проверить("создано товаров", Итог.СозданоТоваров, Ожидается.newItems);
	Проверить("записано цен поставщика", Итог.ЗаписаноЦенПоставщика, Ожидается.supplierWrites);
	Проверить("записано РРЦ", Итог.ЗаписаноРРЦ, Ожидается.rrpWrites);

	ЦенаВБазе = Число1("ВЫБРАТЬ Ц.Цена ИЗ РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(, Номенклатура = &П1 И ВидЦенКонтрагента.Владелец = &П2) КАК Ц",
		Ошибка.Номенклатура, Параметры.Поставщик);
	Проверить("в базе осталась верная цена, а не цена со сдвигом запятой", ЦенаВБазе, Ожидается.decimalSlipPriceInDb);

КонецПроцедуры

Процедура ТестCSV(ФайлXLSX, ФайлCSV)

	Параметры = ПараметрыАльфамарт();
	X = Разобрать(ФайлXLSX, Параметры).Позиции;
	C = Обработка.РазобратьПрайс(Обработка.ПрочитатьФайл(ФайлCSV), , Обработка.ИмяФайла(ФайлCSV)).Позиции;
	Проверить("позиций столько же", C.Количество(), X.Количество());
	Расхождений = 0;
	Первое = "";
	// Сравниваем по порядку строк: в прайсе есть намеренный повтор кода, поиск по коду нашёл бы не ту строку.
	Для Каждого Позиция Из X Цикл
		Индекс = X.Индекс(Позиция);
		Пара = ?(Индекс < C.Количество(), C[Индекс], Неопределено);
		Если Пара = Неопределено Или Пара.Ключ <> Позиция.Ключ Или Пара.Цена <> Позиция.Цена Или Пара.РРЦ <> Позиция.РРЦ
			Или Пара.Наименование <> Позиция.Наименование Или Пара.Категория <> Позиция.Категория Тогда
			Расхождений = Расхождений + 1;
			Если ПустаяСтрока(Первое) Тогда
				Первое = Позиция.Ключ + ": xlsx " + Позиция.Наименование + " / " + Позиция.Цена + " / " + Позиция.РРЦ
					+ ?(Пара = Неопределено, "; в csv нет", "; csv " + Пара.Наименование + " / " + Пара.Цена + " / " + Пара.РРЦ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Проверить("коды, наименования, разделы и цены совпадают построчно" + ?(ПустаяСтрока(Первое), "", " (" + Первое + ")"), Расхождений, 0);
	Проверить("кириллица из Windows-1251 прочитана верно", C[0].Категория, X[0].Категория);

КонецПроцедуры

// Сбой происходит после того, как созданы товар, соответствие, цены поставщика и документ РРЦ,
// но до фиксации транзакции (так бывает при обрыве связи или конфликте блокировок).
// В базе не должно остаться ничего из этой загрузки.
Процедура ТестОтката()

	Параметры = ПараметрыАльфамарт();
	Параметры.Вставить("ИмитироватьСбой", Истина);
	Позиции = Обработка.НоваяТаблицаПозиций();

	НоваяПозиция = Позиции.Добавить();
	НоваяПозиция.Статус = "Новый";
	НоваяПозиция.Применить = Истина;
	НоваяПозиция.Ключ = "ТЕСТ-ОТКАТ-1";
	НоваяПозиция.Наименование = "Тестовый товар для проверки отката";
	НоваяПозиция.Штрихкод = "4607000000017";
	НоваяПозиция.Цена = 10;
	НоваяПозиция.РРЦ = 20;
	НоваяПозиция.ИзменитсяЦена = Истина;
	НоваяПозиция.ИзменитсяРРЦ = Истина;
	НоваяПозиция.ГруппаТовара = Справочники.Номенклатура.НайтиПоНаименованию("Стремянки", Истина);

	Стремянка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "9353");
	Известная = Позиции.Добавить();
	Известная.Статус = "Изменение цены";
	Известная.Применить = Истина;
	Известная.Ключ = "ТЕСТ-ОТКАТ-2";
	Известная.Наименование = "Лестница приставная 8 ступеней";
	Известная.Номенклатура = Стремянка;
	Известная.Цена = 12345;
	Известная.РРЦ = 23456;
	Известная.ИзменитсяЦена = Истина;
	Известная.ИзменитсяРРЦ = Истина;

	СоответствийДо = Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Справочник.НоменклатураПоставщиков ГДЕ Владелец = &П1", Параметры.Поставщик);
	ДокументовДо = Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.УстановкаЦенНоменклатуры");
	Итог = Обработка.Загрузить(Позиции, Параметры);
	Проверить("загрузка отменена", Итог.Успех, Ложь);
	Проверить("пользователь видит причину", СтрНайти(Итог.ТекстОшибки, "Имитация сбоя") > 0, Истина);
	Проверить("новый товар не остался в базе", ЗначениеЗаполнено(Справочники.Номенклатура.НайтиПоНаименованию("Тестовый товар для проверки отката", Истина)), Ложь);
	Проверить("штрихкод не остался в базе", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ШтрихкодыНоменклатуры ГДЕ Штрихкод = ""4607000000017"""), 0);
	Проверить("соответствия не записались", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Справочник.НоменклатураПоставщиков ГДЕ Владелец = &П1", Параметры.Поставщик), СоответствийДо);
	Проверить("цена поставщика не записалась", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ЦеныНоменклатурыКонтрагентов ГДЕ Цена = 12345"), 0);
	Проверить("документ РРЦ не остался", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.УстановкаЦенНоменклатуры"), ДокументовДо);
	Проверить("розничная цена не изменилась", Число1("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ЦеныНоменклатуры ГДЕ Цена = 23456"), 0);

КонецПроцедуры

Процедура ТестОбъема(Файл)

	Параметры = ПараметрыАльфамарт();
	Параметры.ДатаПрайса = Дата(2026, 11, 21);
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Разбор = Обработка.РазобратьПрайс(Обработка.ПрочитатьФайл(Файл), , Обработка.ИмяФайла(Файл));
	Сводка = Обработка.Сопоставить(Разбор.Позиции, Параметры);
	Сверка = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Проверить("позиций прочитано", Разбор.Позиции.Количество(), 1000);
	Проверить("ошибок нет", Сводка.Ошибок, 0);
	Новинок = 0;
	Для Каждого Позиция Из Разбор.Позиции Цикл
		Новинок = Новинок + ?(СтрНачинаетсяС(Позиция.Ключ, "АМ-Б"), 1, 0);
	КонецЦикла;
	Проверить("новых товаров ровно столько, сколько новинок в файле: известные не задвоились", Сводка.Новых, Новинок);

	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Обработка.Загрузить(Разбор.Позиции, Параметры);
	Загрузка = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Проверить("загрузка 1000 позиций прошла", Итог.Успех, Истина);
	Проверить("создано новых товаров", Итог.СозданоТоваров, Сводка.Новых);
	Проверить("РРЦ разбиты на документы по " + Обработка.СтрокВДокументеЦен() + " строк", Итог.Документы.Количество(),
		Цел((Итог.ЗаписаноРРЦ + Обработка.СтрокВДокументеЦен() - 1) / Обработка.СтрокВДокументеЦен()));
	Строки.Добавить("  этапы записи: " + ПредставлениеВремени(Итог.Время));
	Строки.Добавить(СтрШаблон("  время: чтение и сверка %1 с, запись %2 с (новых товаров %3, цен поставщика %4, РРЦ %5)",
		Формат(Сверка / 1000, "ЧДЦ=1"), Формат(Загрузка / 1000, "ЧДЦ=1"), Итог.СозданоТоваров, Итог.ЗаписаноЦенПоставщика, Итог.ЗаписаноРРЦ));

КонецПроцедуры

